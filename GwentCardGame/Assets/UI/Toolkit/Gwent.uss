/* The menus' look in UI Toolkit: The Witcher 3's dark panels, gold rules and serif small caps.
   The colours are UITheme's; the sprites are Assets/UI/Sprites (Gwent > UI > Regenerate Sprites and Theme). */

:root {
    --gold: #C9A45C;
    --gold-bright: #E3C27E;
    --gold-clear: rgba(201, 164, 92, 0);
    --gold-band: rgba(201, 164, 92, 0.2);
    --gold-band-pressed: rgba(201, 164, 92, 0.3);
    --text: #ECE1C9;
    --text-bright: #F6ECD4;
    --text-secondary: #B9AD95;
    --text-muted: #8F826C;
    --background: #16120E;
    --panel: rgba(32, 26, 21, 0.96);
    --panel-raised: #2A2219;
    --line: #4D3F2C;
    --line-soft: #3A2F22;
    --dimmer: rgba(0, 0, 0, 0.65);

    --heading-font: url("project://database/Assets/Fonts/Cinzel.ttf");
    --body-font: url("project://database/Assets/Fonts/AlegreyaSans-Regular.ttf");
}

/* A screen fills the panel (its UXML lets clicks through where it shows nothing: picking-mode="Ignore") */
.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.caption {
    -unity-font-definition: var(--body-font);
    font-size: 24px;
    color: var(--text-muted);
}

/*---------------------------------------- Menu entries ----------------------------------------*/
/* Serif text that lights up with a gold rule and a fading band when hovered or focused (hovering focuses: the mouse and
   the keyboard share one highlight, as in The Witcher 3) */
.menu-item {
    height: 76px;
    margin: 0 0 12px 0;
    padding: 0 0 2px 36px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Sprites/GradientH.png");
    -unity-background-image-tint-color: var(--gold-clear);
    -unity-font-definition: var(--heading-font);
    font-size: 40px;
    letter-spacing: 2.9px; /* TMP's character spacing 4 at this size */
    -unity-text-align: middle-left;
    color: var(--text-secondary);
    transition-property: color, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.menu-item__rule {
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 4px;
    background-color: var(--gold);
    opacity: 0;
    transition-property: opacity, background-color;
    transition-duration: 0.12s;
}

.menu-item:hover,
.menu-item:focus {
    color: var(--text-bright);
    -unity-background-image-tint-color: var(--gold-band);
}

.menu-item:hover > .menu-item__rule,
.menu-item:focus > .menu-item__rule {
    opacity: 1;
}

.menu-item:active {
    color: var(--gold-bright);
    -unity-background-image-tint-color: var(--gold-band-pressed);
}

.menu-item:active > .menu-item__rule {
    background-color: var(--gold-bright);
}

/*---------------------------------------- Main menu ----------------------------------------*/
/* Darkens the left of the key art so the entries read on top of it */
.main-menu__scrim {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 840px;
    background-image: url("project://database/Assets/UI/Sprites/GradientH.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.9);
}

/* Seven entries' room (the web build has no Quit), a little below the middle */
.main-menu__entries {
    position: absolute;
    left: 120px;
    top: 50%;
    margin-top: -230px;
    width: 600px;
    height: 540px;
}

/* The bottom right corner: the version and build on a line (the commit a link), the fan project's note centred under them,
   small */
.main-menu__corner {
    position: absolute;
    right: 156px;
    bottom: 40px;
    align-items: center;
}

.main-menu__build {
    flex-direction: row;
    align-items: center;
}

.main-menu__build > .caption {
    padding: 0;
    margin: 0;
}

.main-menu__commit {
    color: var(--gold);
    transition-property: color;
    transition-duration: 0.12s;
}

.main-menu__build > .main-menu__commit:hover {
    color: var(--gold-bright);
}

.main-menu__note {
    font-size: 14px;
    padding: 0;
    margin: 6px 0 0 0;
}

/* A newer build is out: in the top right corner, where the key art leaves room, its right edge in line with the version's
   (the body font: its width is measured right, as the headings' spaced capitals' isn't; .unity-button too, to win over the
   buttons' own size and font, further down) */
.unity-button.main-menu__update {
    position: absolute;
    right: 156px;
    top: 48px;
    width: auto;
    height: 58px;
    padding: 0 28px 2px 28px;
    -unity-font-definition: var(--body-font);
    font-size: 26px;
    letter-spacing: 0;
    background-color: rgba(20, 16, 12, 0.72);
    display: none;
}

/*---------------------------------------- Dialogs ----------------------------------------*/
/* Darkens the whole screen behind a dialog and takes its clicks */
.dimmer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--dimmer);
    align-items: center;
    justify-content: center;
}

/* A rounded panel with a thin bronze outline */
.panel {
    background-color: var(--panel);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 10px;
}

.title {
    -unity-font-definition: var(--heading-font);
    font-size: 44px;
    letter-spacing: 3.2px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* A thin gold rule with a diamond in the middle */
.ornament {
    width: 420px;
    height: 12px;
    background-image: url("project://database/Assets/UI/Sprites/Rule.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(201, 164, 92, 0.85);
}

/*---------------------------------------- Buttons ----------------------------------------*/
.button {
    width: 280px;
    height: 68px;
    margin: 0;
    padding: 0 12px 2px 12px;
    border-width: 2px;
    border-radius: 10px;
    -unity-font-definition: var(--heading-font);
    font-size: 28px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: color, background-color, border-color;
    transition-duration: 0.12s;
}

/* Gold outline and text: Back, No, Cancel */
.button--secondary {
    background-color: rgba(201, 164, 92, 0);
    border-color: var(--gold);
    color: var(--gold);
}

/* (.unity-button too: the default theme's focus border, blue, is as specific as a class and a state) */
.unity-button.button--secondary:hover,
.unity-button.button--secondary:focus {
    background-color: rgba(201, 164, 92, 0.16);
    border-color: var(--gold-bright);
    color: var(--gold-bright);
}

.unity-button.button--secondary:active {
    background-color: rgba(201, 164, 92, 0.28);
}

/* A gold-ringed × in a dialog's top right corner: it closes the dialog (as Escape does), as the battle's chat window's ×
   does; no "Back" or "Esc to close" */
.button--close {
    position: absolute;
    top: 28px;
    right: 28px;
    width: 46px;
    height: 46px;
    padding: 0 0 6px 0;
    border-width: 2px;
    border-radius: 10px;
    border-color: rgba(201, 164, 92, 0.7);
    background-color: rgba(201, 164, 92, 0);
    -unity-font-definition: var(--body-font);
    font-size: 50px;
    letter-spacing: 0;
    color: var(--gold);
}

.unity-button.button--close:hover,
.unity-button.button--close:focus {
    background-color: rgba(201, 164, 92, 0.16);
    border-color: var(--gold-bright);
    color: var(--gold-bright);
}

.unity-button.button--close:active {
    background-color: rgba(201, 164, 92, 0.28);
}

/* On a phone (UIScreens adds .phone to every screen and dialog): the × takes a finger, nearer the corner */
.phone .button--close {
    top: 20px;
    right: 20px;
    width: 62px;
    height: 62px;
    padding-bottom: 8px;
    font-size: 66px;
}

/* Gold fill, dark text: the choice a dialog is about */
.button--primary {
    background-color: var(--gold);
    border-color: var(--gold);
    color: var(--background);
}

.unity-button.button--primary:hover,
.unity-button.button--primary:focus {
    background-color: var(--gold-bright);
    border-color: var(--gold-bright);
}

.unity-button.button--primary:active {
    background-color: #AB8B4E;
    border-color: #AB8B4E;
}

/*---------------------------------------- Opponent picker ----------------------------------------*/
.opponent-picker {
    width: 1300px;
    max-height: 96%;
    padding: 34px 40px 36px 40px;
    align-items: center;
}

.opponent-picker__ornament {
    margin: 14px 0 30px 0;
}

/* Two entries a row, scrolling when they don't all fit (the bar in the panel's right padding) */
.opponent-picker__entries {
    width: 1244px;
    flex-shrink: 1;
    margin-right: -24px;
}

/* (the picker's own name: to win over the scroll view's column) */
.opponent-picker #Entries .unity-scroll-view__content-container {
    width: 1220px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

/* One opponent: the leader's portrait in a gold ring, the deck's name, its faction and leader; lights up like a menu
   entry (it is one: .menu-item gives the band, the rule and the focus on hover) */
.opponent {
    width: 600px;
    height: 104px;
    margin: 0 0 12px 0;
    padding: 0 0 0 20px;
    flex-direction: row;
    align-items: center;
}

.opponent__portrait {
    width: 88px;
    height: 88px;
    border-width: 4px;
    border-color: var(--gold);
    border-radius: 44px;
    overflow: hidden;
    background-color: var(--panel-raised);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* A leader's round portrait: framed on the face from code (LeaderFaces, which sizes and places it); empty while its art
   loads, then the face fades in (CardArt.ShowPortrait) */
.portrait-art {
    transition-property: opacity;
    transition-duration: 0.3s;
}

/* The leader's card, its face in the circle (LeaderFaces frames it; these are its sizes before) */
.opponent__art {
    position: absolute;
    left: -30px;
    top: -21px;
    width: 140px;
    height: 218px;
    -unity-background-scale-mode: stretch-to-fill;
}

.opponent__question {
    -unity-font-definition: var(--heading-font);
    font-size: 44px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    padding: 0 0 4px 0;
}

.opponent__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 22px;
}

.opponent__title {
    -unity-font-definition: var(--heading-font);
    font-size: 30px;
    letter-spacing: 2.2px;
    color: var(--text);
    padding: 0;
    margin: 0;
    transition-property: color;
    transition-duration: 0.12s;
}

.opponent:hover .opponent__title,
.opponent:focus .opponent__title {
    color: var(--gold-bright);
}

.opponent__detail {
    -unity-font-definition: var(--body-font);
    font-size: 24px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.opponent__chosen {
    width: 32px;
    height: 32px;
    margin: 0 18px 0 8px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/UI/Sprites/IconCheck.png");
    -unity-background-image-tint-color: var(--gold);
}

/*---------------------------------------- Multiplayer picker ----------------------------------------*/
.mode-picker {
    width: 900px;
    padding: 34px 40px 36px 40px;
    align-items: center;
}

/* One way to play someone a row, an opponent's entry (.opponent): an icon in the gold ring, its name and what it needs;
   on the right, a tag saying why it cannot be chosen, or that a battle waits there */
.mode-picker__entries {
    width: 820px;
}

.mode-picker__entries .opponent {
    width: 100%;
}

.mode__icon {
    width: 48px;
    height: 48px;
    -unity-background-image-tint-color: var(--gold-bright);
}

.mode__icon--network {
    background-image: url("project://database/Assets/UI/Sprites/IconNetwork.png");
}

.mode__icon--online {
    background-image: url("project://database/Assets/UI/Sprites/IconGlobe.png");
}

.mode__tag {
    -unity-font-definition: var(--heading-font);
    font-size: 22px;
    letter-spacing: 1.4px;
    color: var(--text-muted);
    margin: 0 24px 0 12px;
    padding: 0;
    flex-shrink: 0;
}

.mode__tag--on {
    color: var(--gold);
}

/* Not there yet, or not here: muted, and nothing lights it up (Unity's own disabled look would dim it twice and grey its
   band) */
.menu-item.mode--off,
.menu-item.mode--off:disabled {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--gold-clear);
}

.mode--off .opponent__title,
.mode--off .opponent__detail {
    color: var(--text-muted);
}

.mode--off .opponent__portrait {
    border-color: var(--line-soft);
}

.mode--off .mode__icon {
    -unity-background-image-tint-color: var(--text-muted);
}

/*---------------------------------------- Play on LAN ----------------------------------------*/
.lan {
    width: 1320px;
    padding: 34px 50px 36px 50px;
    align-items: center;
}

.lan__ornament {
    margin: 14px 0 26px 0;
}

/* You: your leader's portrait, your name and the deck you play */
.lan__you {
    width: 1220px;
    flex-direction: row;
    align-items: center;
    padding: 14px 22px;
    margin: 0 0 18px 0;
    background-color: rgba(10, 8, 6, 0.45);
    border-width: 1px;
    border-color: var(--line-soft);
    border-radius: 10px;
}

/* Your name: a field with a pencil in it; while it is typed, the count of what is typed instead, and the rule just under
   it (over the strip's edge: nothing moves) */
.lan__you-name {
    width: 400px;
    margin: 0 30px 0 22px;
    flex-shrink: 0;
}

.lan__you-deck {
    flex-grow: 1;
    flex-shrink: 1;
}

.lan__deck-name {
    -unity-font-definition: var(--heading-font);
    font-size: 26px;
    letter-spacing: 1.8px;
    color: var(--text);
    padding: 0;
    margin: 0 0 4px 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.lan__hint {
    position: absolute;
    top: 58px;
    left: 2px;
    -unity-font-definition: var(--body-font);
    font-size: 20px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
}

.lan__detail {
    -unity-font-definition: var(--body-font);
    font-size: 24px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
    white-space: normal;
}

/* A field to type in: a dark well with a bronze outline, gold when it has the keyboard */
.lan__field {
    margin: 0;
    height: 56px;
}

.lan__field .unity-base-text-field__input {
    background-color: rgba(10, 8, 6, 0.6);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 8px;
    padding: 0 16px;
    -unity-font-definition: var(--body-font);
    font-size: 28px;
    color: var(--text);
    --unity-cursor-color: var(--gold-bright);
    --unity-selection-color: rgba(201, 164, 92, 0.35);
}

.lan__field .unity-base-text-field__input--placeholder {
    color: var(--text-muted);
}

/* As specific as the default theme's outline on hover and focus (grey, blue), to be the game's instead */
.lan__field.unity-base-text-field:hover:enabled > .unity-base-text-field__input {
    border-color: var(--line);
}

.lan__field.unity-base-text-field:focus:enabled > .unity-base-text-field__input {
    border-color: var(--gold);
}

.lan__name-row {
    height: 56px;
}

.lan__name {
    width: 100%;
}

.lan__name .unity-base-text-field__input {
    padding: 0 60px 0 16px;
    -unity-font-definition: var(--heading-font);
    font-size: 28px;
    letter-spacing: 1.8px;
    color: var(--gold-bright);
}

.lan__name-edit {
    position: absolute;
    right: 18px;
    top: 15px;
    width: 26px;
    height: 26px;
    background-image: url("project://database/Assets/UI/Sprites/IconEdit.png");
    -unity-background-image-tint-color: var(--text-muted);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.lan__name-row:hover .lan__name-edit {
    -unity-background-image-tint-color: var(--gold-bright);
}

.lan__name-count {
    position: absolute;
    right: 16px;
    top: 0;
    height: 56px;
    -unity-text-align: middle-right;
    -unity-font-definition: var(--body-font);
    font-size: 20px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
    display: none;
}

/* While the name is typed: its count instead of the pencil */
.lan__name-row--editing .lan__name-edit {
    display: none;
}

.lan__name-row--editing .lan__name-count {
    display: flex;
}

.lan__small-button {
    width: 200px;
    height: 56px;
    font-size: 24px;
    margin-left: 14px;
    flex-shrink: 0;
}

/* What went wrong (turned away, the host gone, another version): in place, plainly */
.lan__problem {
    width: 1220px;
    padding: 12px 22px;
    margin: 0 0 16px 0;
    border-width: 1px;
    border-color: rgba(196, 92, 72, 0.7);
    border-radius: 10px;
    background-color: rgba(120, 40, 28, 0.25);
    -unity-font-definition: var(--body-font);
    font-size: 26px;
    color: #E8B0A2;
    white-space: normal;
}

/* A battle still on: a gold-edged card above the rest */
.lan__card {
    width: 1220px;
    flex-direction: row;
    align-items: center;
    padding: 16px 22px;
    margin: 0 0 18px 0;
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 10px;
    background-color: var(--gold-band);
}

.lan__card-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 24px;
}

.lan__card-title {
    -unity-font-definition: var(--heading-font);
    font-size: 30px;
    letter-spacing: 2px;
    color: var(--gold-bright);
    padding: 0;
    margin: 0 0 4px 0;
    white-space: normal;
}

/* The battles on your network: a heading with a live dot, the battles two a row, or what to do */
.lan__browse {
    width: 1220px;
    align-items: center;
}

.lan__section-head {
    width: 1220px;
    flex-direction: row;
    align-items: center;
    margin: 0 0 12px 0;
}

.lan__heading {
    -unity-font-definition: var(--heading-font);
    font-size: 26px;
    letter-spacing: 1.8px;
    color: var(--text-secondary);
    padding: 0;
    margin: 0;
}

.lan__live {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: 0 10px 0 22px;
    background-color: var(--gold);
    transition-property: opacity;
    transition-duration: 0.6s;
}

.lan__live--dim {
    opacity: 0.2;
}

.lan__live-text {
    -unity-font-definition: var(--body-font);
    font-size: 22px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
}

/* The battles found: one a row, in the same frame as the empty list's */
.lan__games {
    width: 1220px;
    max-height: 330px; /* three battles; more scroll */
    padding: 8px 0;
    border-width: 1px;
    border-color: var(--line-soft);
    border-radius: 10px;
    background-color: rgba(10, 8, 6, 0.3);
}

.lan__games .opponent {
    width: 100%;
    margin: 0;
    padding-left: 24px;
}

.lan__game--other .opponent__title,
.lan__game--other .opponent__detail {
    color: var(--text-muted);
}

.lan__join {
    -unity-font-definition: var(--heading-font);
    font-size: 24px;
    letter-spacing: 1.6px;
    color: var(--gold);
    margin: 0 22px 0 8px;
    padding: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.opponent:hover .lan__join,
.opponent:focus .lan__join,
.lan__game--touch .lan__join {
    opacity: 1;
}

.lan__empty {
    width: 1220px;
    padding: 24px 40px;
    margin: 0 0 6px 0;
    align-items: center;
    border-width: 1px;
    border-color: var(--line-soft);
    border-radius: 10px;
    background-color: rgba(10, 8, 6, 0.3);
}

.lan__empty-body {
    -unity-font-definition: var(--body-font);
    font-size: 24px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 0;
}

.lan__address {
    width: 1220px;
    flex-direction: row;
    align-items: center;
    margin: 14px 0 0 0;
}

.lan__address-field {
    flex-grow: 1;
}

.button--ghost.lan__link {
    margin-top: 10px;
    font-size: 24px;
    height: 44px;
}

/* The room: you and the other player face to face */
.lan__room {
    width: 1220px;
    align-items: center;
}

.lan__versus {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 18px 0 10px 0;
}

/* Both seats' contents from the top: the portraits level, whatever wraps under them */
.lan__seat {
    width: 470px;
    height: 350px;
    align-items: center;
    justify-content: flex-start;
    padding: 24px 20px 16px 20px;
    border-width: 1px;
    border-color: var(--line-soft);
    border-radius: 12px;
    background-color: rgba(10, 8, 6, 0.4);
}

.lan__seat--filled {
    border-color: var(--line);
}

.lan__seat-portrait {
    width: 150px;
    height: 150px;
    border-width: 5px;
    border-color: var(--gold);
    border-radius: 75px;
    overflow: hidden;
    background-color: var(--panel-raised);
    margin-bottom: 14px;
}

/* The leader's card in the big ring, its face in the middle */
.lan__seat-art {
    position: absolute;
    left: -42px;
    top: -30px;
    width: 230px;
    height: 358px;
    -unity-background-scale-mode: stretch-to-fill;
}

.lan__seat-crest {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 98px;
    height: 70px;
    -unity-background-scale-mode: scale-to-fit;
}

.lan__seat-name {
    -unity-font-definition: var(--heading-font);
    font-size: 32px;
    letter-spacing: 2.2px;
    color: var(--text-bright);
    padding: 0;
    margin: 0 0 4px 0;
    -unity-text-align: middle-center;
}

.lan__seat-detail {
    -unity-font-definition: var(--body-font);
    font-size: 23px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.lan__seat-chip {
    margin-top: 12px;
    padding: 2px 16px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--gold);
    -unity-font-definition: var(--body-font);
    font-size: 20px;
    color: var(--gold-bright);
}

/* An empty seat: a ring breathing in and out until someone sits */
.lan__seat-wait {
    width: 150px;
    height: 150px;
    border-width: 3px;
    border-color: var(--gold);
    border-radius: 75px;
    background-color: rgba(42, 34, 25, 0.7);
    margin-bottom: 14px;
    opacity: 0.85;
    transition-property: opacity, scale;
    transition-duration: 0.6s;
}

.lan__seat-wait--dim {
    opacity: 0.25;
    scale: 0.92 0.92;
}

.lan__vs {
    -unity-font-definition: var(--heading-font);
    font-size: 54px;
    letter-spacing: 3px;
    color: var(--gold);
    margin: 0 38px;
    padding: 0 0 10px 0;
}

.lan__status {
    -unity-font-definition: var(--body-font);
    font-size: 28px;
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 8px 0 0 0;
    padding: 0;
}

.lan__reach {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 6px 0 0 0;
}

.button--ghost.lan__copy {
    width: auto;
    height: 40px;
    margin-left: 10px;
    padding: 0 10px;
    font-size: 22px;
    color: var(--gold);
}

/* The host's networks, on asking: what each is, its adapter, the address there; the ports and what a VPN's address is for */
.lan__details {
    width: 860px;
    margin: 8px 0 0 0;
    padding: 10px 24px 14px 24px;
    background-color: rgba(10, 8, 6, 0.45);
    border-width: 1px;
    border-color: var(--line-soft);
    border-radius: 10px;
}

.lan__network {
    flex-direction: row;
    align-items: center;
    height: 46px;
}

.lan__network-kind {
    width: 190px;
    -unity-font-definition: var(--heading-font);
    font-size: 22px;
    letter-spacing: 1.4px;
    color: var(--gold-bright);
    padding: 0;
    margin: 0;
}

.lan__network-adapter {
    width: 230px;
    -unity-font-definition: var(--body-font);
    font-size: 20px;
    color: var(--text-muted);
    padding: 0 12px 0 0;
    margin: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.lan__network-address {
    flex-grow: 1;
    -unity-font-definition: var(--body-font);
    font-size: 24px;
    color: var(--text-bright);
    padding: 0;
    margin: 0;
}

.lan__details-note {
    -unity-font-definition: var(--body-font);
    font-size: 20px;
    color: var(--text-muted);
    white-space: normal;
    padding: 0;
    margin: 6px 0 0 0;
}

.lan__buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 26px;
}

/* The build, small in the panel's bottom left corner: both players need the same */
.lan__build {
    position: absolute;
    left: 28px;
    bottom: 18px;
    -unity-font-definition: var(--body-font);
    font-size: 18px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
}

.lan__button {
    width: 300px;
    height: 64px;
    margin: 0 14px;
}

/* Plain text that lights up: Reset to defaults, the settings' tabs */
.button--ghost {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: var(--body-font);
    font-size: 28px;
    letter-spacing: 0;
    color: var(--text-muted);
}

.button--ghost:hover,
.button--ghost:focus {
    color: var(--text);
}

.button--ghost:active {
    color: var(--text-secondary);
}

.heading {
    -unity-font-definition: var(--heading-font);
    font-size: 44px;
    letter-spacing: 3.2px;
    color: var(--gold-bright);
    padding: 0;
    margin: 0;
}

.caption {
    padding: 0;
    margin: 0;
}

.divider {
    height: 2px;
    background-color: var(--line-soft);
}

/*---------------------------------------- Settings ----------------------------------------*/
.settings {
    width: 1040px;
    height: 800px;
    padding: 0 64px 32px 64px;
}

.settings__header {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 104px;
}

.settings__tabs {
    flex-shrink: 0;
    flex-direction: row;
    height: 64px;
    margin-bottom: 14px;
}

.tab {
    width: 200px;
    height: 56px;
    margin: 0 16px 0 0;
    padding: 0 0 2px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: var(--heading-font);
    font-size: 28px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    color: var(--text-muted);
    transition-property: color;
    transition-duration: 0.12s;
}

.tab:hover,
.tab:focus {
    color: var(--text-secondary);
}

.tab--selected,
.tab--selected:hover,
.tab--selected:focus {
    color: var(--text-bright);
}

.tab__underline {
    position: absolute;
    left: 0;
    bottom: 4px;
    width: 120px;
    height: 3px;
    background-color: var(--gold);
    display: none;
}

.tab--selected > .tab__underline {
    display: flex;
}

/* The pages take what is left between the tabs and the footer (a longer page scrolls in it). They reach into the
   panel's right margin (their rows do not: padding), where a scrolling page has its scroll bar */
.settings__pages {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    overflow: hidden;
    margin: 32px -40px 0 0;
    padding-right: 40px;
}

/* Under a divider, as the tabs are over one */
.settings__footer {
    flex-shrink: 0;
    padding-top: 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.settings__reset {
    width: 300px;
    height: 56px;
    -unity-text-align: middle-left;
    padding-left: 0;
}

/* A page longer than the panel (Graphics) scrolls. Its scroll bar stands in the panel's right margin, so its rows line
   up with the other pages'; the rows fade out where they are cut */
.settings__scroll {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: -40px;
}

.settings__scroll .unity-scroll-view__content-container {
    padding-right: 28px;
}

/* (.settings first: these are to win over the shared .scroll rules below) */
.settings .settings__scroll .unity-scroller--vertical {
    width: 12px;
    margin-left: 0;
}

.settings .settings__scroll .unity-scroller--vertical .unity-base-slider__tracker {
    left: 4px;
    width: 4px;
    border-radius: 2px;
    background-color: var(--line-soft);
}

.settings .settings__scroll .unity-scroller--vertical .unity-base-slider__dragger {
    left: 2px;
    width: 8px;
    border-radius: 4px;
    background-color: var(--gold);
}

.settings .settings__scroll .unity-scroller--vertical .unity-base-slider__dragger:hover,
.settings .settings__scroll .unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: var(--gold-bright);
}

.settings__fade {
    position: absolute;
    left: 0;
    right: 12px;
    height: 56px;
}

.settings__fade--top {
    top: 0;
}

.settings__fade--bottom {
    bottom: 0;
    scale: 1 -1;
}

/* A heading over a group of rows (Graphics: Weather, Battle effects...): gold, smaller than the tabs */
.setting__group {
    -unity-font-definition: var(--heading-font);
    font-size: 24px;
    letter-spacing: 2px;
    color: var(--gold);
    padding: 0;
    margin: 22px 0 0 0;
}

/* A labelled row: the label (and a caption under it) on the left, the control on the right */
.setting {
    flex-direction: row;
    align-items: center;
    height: 92px;
}

.setting__labels {
    flex-grow: 1;
    flex-shrink: 1;
}

.setting__label {
    -unity-font-definition: var(--body-font);
    font-size: 30px;
    color: var(--text-secondary);
    padding: 0;
    margin: 0;
}

.setting__control {
    width: 520px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.setting__percent {
    -unity-font-definition: var(--body-font);
    font-size: 32px;
    color: var(--text);
    width: 84px;
    -unity-text-align: middle-right;
    padding: 0;
    margin: 0;
}

/* The volume slider: a thin track, the gold part up to a dark knob in a gold ring */
.volume {
    width: 400px;
    height: 44px;
    margin: 0 16px 0 0;
}

.volume .unity-base-slider__input {
    height: 44px;
}

.volume .unity-base-slider__drag-container {
    height: 44px;
    margin: 0 14px;
}

.volume .unity-base-slider__tracker {
    height: 8px;
    margin-top: -4px;
    top: 50%;
    border-width: 0;
    border-radius: 4px;
    background-color: var(--line-soft);
    left: -14px;
    right: -14px;
}

.volume .unity-base-slider__fill {
    height: 8px;
    border-radius: 4px;
    background-color: var(--gold);
}

.volume .unity-base-slider__dragger {
    width: 28px;
    height: 28px;
    margin-top: -14px;
    top: 50%;
    border-width: 3px;
    border-radius: 14px;
    border-color: var(--gold);
    background-color: var(--background);
    transition-property: border-color;
    transition-duration: 0.12s;
}

.volume:hover .unity-base-slider__dragger,
.volume:focus .unity-base-slider__dragger {
    border-color: var(--gold-bright);
}

.volume .unity-base-slider__dragger-border {
    display: none;
}

/* The on/off switch: a pill and a knob that slides across, gold when on */
.switch {
    margin: 0;
}

/* (as specific as the default theme's no-label field, which would squeeze the input to nothing) */
.switch.unity-base-field--no-label > .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 76px;
    overflow: visible;
}

.switch .unity-toggle__checkmark {
    width: 76px;
    height: 40px;
    border-width: 0;
    border-radius: 20px;
    background-image: none;
    background-color: var(--line-soft);
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.switch:checked .unity-toggle__checkmark {
    background-color: var(--gold);
}

.switch__knob {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 15px;
    background-color: var(--text-secondary);
    transition-property: translate, background-color;
    transition-duration: 0.15s;
}

.switch:checked .switch__knob {
    translate: 36px 0;
    background-color: var(--background);
}

.switch:focus .unity-toggle__checkmark {
    border-width: 2px;
    border-color: var(--gold-bright);
}

/* < value > */
.stepper {
    width: 420px;
    height: 52px;
    flex-direction: row;
    align-items: center;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--line-soft);
}

.stepper__value {
    flex-grow: 1;
    -unity-font-definition: var(--body-font);
    font-size: 32px;
    color: var(--text);
    -unity-text-align: middle-center;
    padding: 0 0 2px 0;
    margin: 0;
}

.stepper__arrow {
    width: 52px;
    height: 48px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.stepper__icon {
    width: 39px;
    height: 39px;
    -unity-background-image-tint-color: var(--gold);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.12s;
}

.stepper__arrow--left .stepper__icon {
    background-image: url("project://database/Assets/UI/Sprites/ChevronLeft.png");
}

.stepper__arrow--right .stepper__icon {
    background-image: url("project://database/Assets/UI/Sprites/ChevronRight.png");
}

.stepper__arrow:hover .stepper__icon,
.stepper__arrow:focus .stepper__icon {
    -unity-background-image-tint-color: var(--gold-bright);
}

.stepper__arrow:active .stepper__icon {
    -unity-background-image-tint-color: var(--text-bright);
}

.stepper__arrow:disabled .stepper__icon {
    -unity-background-image-tint-color: rgba(201, 164, 92, 0.3);
}

/* Unity's own look for a disabled control would dim the whole arrow twice */
.stepper__arrow:disabled {
    opacity: 1;
}

.body {
    -unity-font-definition: var(--body-font);
    font-size: 32px;
    color: var(--text);
    padding: 0;
    margin: 0;
}

.panel--raised {
    background-color: var(--panel-raised);
}

/* A menu entry in the middle of a dialog: a radial band and a short rule under the text */
.menu-item--centered {
    width: 520px;
    padding: 0 0 2px 0;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/UI/Sprites/Radial.png");
}

.menu-item--centered > .menu-item__rule {
    left: 50%;
    top: auto;
    bottom: 4px;
    width: 160px;
    height: 2px;
    margin-left: -80px;
}

/*---------------------------------------- Pause menu ----------------------------------------*/
.pause-menu {
    width: 640px;
    padding: 34px 0 40px 0;
    align-items: center;
}

.pause-menu__ornament {
    width: 360px;
    margin: 14px 0 32px 0;
}

/*---------------------------------------- Confirmation ----------------------------------------*/
.confirm {
    width: 920px;
    min-height: 330px;
    padding: 34px 60px 36px 60px;
    align-items: center;
}

.confirm__ornament {
    width: 360px;
}

.confirm__message {
    flex-grow: 1;
    margin: 24px 0 28px 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.confirm__buttons {
    flex-direction: row;
    justify-content: center;
}

.confirm__buttons > .button {
    margin: 0 20px;
}

/* A question's two answers look alike; the selected one (the safe one as it opens; the arrows, Tab or a click move it)
   is filled with gold, as a dialog's choice is: Enter presses it */
/*---------------------------------------- Replays ----------------------------------------*/
/* The replays saved: the opponent picker's panel and rows, a caption under the title, a word when there is none */
.replays__caption {
    margin: -14px 0 20px 0;
    -unity-text-align: middle-center;
}

.replays__empty {
    margin: 40px 0 70px 0;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--text-muted);
    display: none;
}

/* A replay: its entry (as an opponent's) and, beside it, its cross */
.replay {
    width: 600px;
    flex-direction: row;
    align-items: center;
    margin: 0 0 12px 0;
}

.replay > .opponent {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

/* Who played whom on one line, cut short with "…" (the cross takes its room) */
.replay .opponent__title {
    font-size: 26px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* (.unity-button too: to win over the default theme's button) */
.unity-button.replay__action {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    margin: 0 0 0 6px;
    padding: 0;
    border-width: 0;
    border-radius: 10px;
    background-color: rgba(201, 164, 92, 0);
    background-size: 30px 30px;
    -unity-background-image-tint-color: var(--gold);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.unity-button.replay__action:hover,
.unity-button.replay__action:focus {
    background-color: rgba(201, 164, 92, 0.16);
    -unity-background-image-tint-color: var(--gold-bright);
}

/* On a phone: a finger's */
.phone .unity-button.replay__action {
    width: 58px;
    height: 58px;
    background-size: 34px 34px;
}

/*---------------------------------------- Update ----------------------------------------*/
/* A newer build: its notes scroll in the middle, the download's bar and the status under them */
.update {
    width: 1100px;
    max-height: 96%;
    padding: 34px 60px 36px 60px;
    align-items: center;
}

.update__ornament {
    margin: 14px 0 10px 0;
}

.update__detail {
    margin-bottom: 18px;
}

.update__notes {
    width: 100%;
    height: 460px;
    flex-shrink: 1;
}

.update__notes .unity-scroll-view__content-container {
    padding-right: 24px;
}

/* (in the notes: to win over the rules' title and line margins) */
.update__notes .update__heading {
    margin: 18px 0 8px 0;
}

/* A point: its bullet, then its text, wrapped under itself */
.update__notes .update__point {
    flex-direction: row;
    margin-bottom: 6px;
}

.update__bullet {
    width: 30px;
    flex-shrink: 0;
    -unity-text-align: upper-left;
    color: var(--gold);
}

.update__notes .update__point > .update__text {
    flex-grow: 1;
    flex-shrink: 1;
}

/* A point under a point: further in */
.update__notes .update__point--sub {
    padding-left: 30px;
}

.update__notes .update__paragraph {
    margin-bottom: 10px;
}

.update__progress {
    width: 100%;
    height: 8px;
    margin-top: 20px;
    border-radius: 4px;
    background-color: rgba(201, 164, 92, 0.2);
    overflow: hidden;
    visibility: hidden;
}

.update__bar {
    width: 0;
    height: 100%;
    background-color: var(--gold);
}

.update__status {
    margin: 12px 0 18px 0;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: var(--text-muted);
}

.update__buttons {
    flex-direction: row;
    justify-content: center;
}

.update__buttons > .button {
    margin: 0 20px;
}

.unity-button.confirm__choice:focus {
    background-color: var(--gold);
    border-color: var(--gold);
    color: var(--background);
}

.unity-button.confirm__choice:focus:hover {
    background-color: var(--gold-bright);
    border-color: var(--gold-bright);
}

/*---------------------------------------- Toast ----------------------------------------*/
/* At the top of the screen; fades in and out (UIOverlay.Toast) */
.toast {
    position: absolute;
    top: 98px;
    left: 50%;
    width: 1100px;
    min-height: 84px;
    margin-left: -550px;
    padding: 12px 30px 14px 30px;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.toast--shown {
    opacity: 1;
}

.toast__message {
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 30px;
}

/* A toast with keys: its words and key caps in a centred line that flows over */
.toast__line {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.toast__word {
    -unity-font-definition: var(--body-font);
    font-size: 30px;
    color: var(--text);
    padding: 0;
    margin: 2px 4px;
}

/* A key's name in a small gold-ringed cap ("Esc", "Space"), as the battle's buttons show it: no "[Esc]" */
.keycap {
    height: 36px;
    min-width: 36px;
    margin: 2px 6px;
    padding: 0 10px 2px 10px;
    border-width: 2px;
    border-radius: 8px;
    border-color: rgba(201, 164, 92, 0.7);
    align-items: center;
    justify-content: center;
}

.keycap__label {
    -unity-font-definition: var(--body-font);
    font-size: 22px;
    color: var(--gold);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/*---------------------------------------- Tooltip ----------------------------------------*/
.tooltip {
    position: absolute;
    max-width: 640px;
    padding: 8px 18px 10px 18px;
    background-color: var(--panel-raised);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 10px;
    -unity-font-definition: var(--body-font);
    font-size: 26px;
    color: var(--text);
    white-space: normal;
    -unity-text-align: middle-center;
}

/*---------------------------------------- How to play ----------------------------------------*/
.rules {
    width: 1500px;
    height: 820px;
    padding: 30px 50px 26px 50px;
    align-items: center;
}

.rules__ornament {
    margin: 14px 0 22px 0;
}

.rules__body {
    flex-direction: row;
    align-self: stretch;
    flex-grow: 1;
}

.rules__topics {
    width: 360px;
    margin-right: 40px;
}

/* A topic: a menu entry, its rule lit while it is the one shown */
.rules__topic {
    width: 360px;
    height: 66px;
    margin: 0 0 10px 0;
}

.rules__topic--current > .menu-item__rule {
    opacity: 1;
}

.rules__view {
    flex-grow: 1;
    height: 620px;
}

/* A scroll bar, the deck builder's too (UIKit.VerticalScrollbar): a thin dark track the whole height and a gold handle
   with rounded ends that brightens under the pointer and while dragged; no arrows */
.scroll .unity-scroller--vertical {
    width: 16px;
    margin-left: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.scroll .unity-scroller__low-button,
.scroll .unity-scroller__high-button {
    display: none;
}

.scroll .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
    flex-grow: 1;
}

.scroll .unity-scroller--vertical .unity-base-slider__drag-container {
    margin: 0;
}

.scroll .unity-scroller--vertical .unity-base-slider__tracker {
    left: 6px;
    width: 4px;
    right: auto;
    top: 0;
    bottom: 0;
    margin: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: var(--line-soft);
}

.scroll .unity-scroller--vertical .unity-base-slider__dragger {
    left: 3px;
    width: 10px;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--gold);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.scroll .unity-scroller--vertical .unity-base-slider__dragger:hover,
.scroll .unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: var(--gold-bright);
}

.scroll .unity-base-slider__dragger-border {
    display: none;
}

.rules__view .unity-scroll-view__content-container {
    padding: 0 24px 24px 0;
}

.rules__intro {
    -unity-font-definition: var(--body-font);
    font-size: 32px;
    color: var(--text-secondary);
    white-space: normal;
    padding: 0;
    margin: 0 0 22px 0;
}

/* A rule: its pieces in a column of their own, its gold title and its text; they come in one after another */
.rules__row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 22px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.28s;
    transition-timing-function: ease-in-out-sine;
}

.rules__row--shown {
    opacity: 1;
}

.rules__pieces {
    height: 73px;
    flex-shrink: 0;
    margin-right: 22px;
}

.rules__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.rules__title {
    -unity-font-definition: var(--heading-font);
    font-size: 28px;
    letter-spacing: 2px;
    color: var(--gold-bright);
    padding: 0;
    margin: 0 0 4px 0;
}

.rules__line {
    -unity-font-definition: var(--body-font);
    font-size: 27px;
    color: var(--text);
    white-space: normal;
    padding: 0;
    margin: 0;
}

/* A piece: a picture of the game's, kept in shape */
.piece {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.piece__number {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-definition: var(--heading-font);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* A key of the keyboard: dark, outlined in gold */
.piece--key {
    background-color: var(--panel-raised);
    border-width: 2px;
    border-color: var(--gold);
    border-radius: 7px;
    align-items: center;
    justify-content: center;
}

.piece__key-label {
    -unity-font-definition: url("project://database/Assets/Fonts/AlegreyaSans-Medium.ttf");
    color: var(--gold-bright);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.rules__leaders {
    flex-direction: row;
    padding-top: 6px;
    height: 62px;
}

/* A leader: a round portrait in a gold ring (its ability in a tooltip) */
.rules__leader {
    width: 56px;
    height: 56px;
    margin-right: 10px;
    border-width: 3px;
    border-color: var(--gold);
    border-radius: 28px;
    overflow: hidden;
    background-color: var(--panel-raised);
}

.rules__leader-art {
    position: absolute;
    left: -19px;
    top: -13px;
    width: 88px;
    height: 137px;
    -unity-background-scale-mode: stretch-to-fill;
}

/*---------------------------------------- Unity's own button states ----------------------------------------*/
/* The default theme fills a button grey and outlines it when hovered, focused, pressed or disabled, as specifically as a
   class and a state (two, for a disabled button keeping the focus: a stepper's arrow clicked to its last option): the
   buttons drawn here only by their text, band or icon keep no fill or outline of Unity's */
.unity-button.menu-item:hover, .unity-button.menu-item:focus, .unity-button.menu-item:active,
.unity-button.tab:hover, .unity-button.tab:focus, .unity-button.tab:active,
.unity-button.button--ghost:hover, .unity-button.button--ghost:focus, .unity-button.button--ghost:active,
.unity-button.stepper__arrow:hover, .unity-button.stepper__arrow:focus, .unity-button.stepper__arrow:active,
.unity-button.menu-item:disabled, .unity-button.tab:disabled, .unity-button.button--ghost:disabled, .unity-button.stepper__arrow:disabled,
.unity-button.menu-item:focus:disabled, .unity-button.tab:focus:disabled, .unity-button.button--ghost:focus:disabled,
.unity-button.stepper__arrow:focus:disabled, .unity-button.stepper__arrow:hover:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

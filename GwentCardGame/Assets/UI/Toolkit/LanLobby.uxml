<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:l="UnityEngine.Localization" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Toolkit/Gwent.uss" />
    <!-- Multiplayer > Local network (LanLobby): who you are and what you play; then either the battles on your network (or one at an
         address) and hosting your own, or, hosting or joined, the room: both players face to face. A battle still on is
         offered first. -->
    <ui:VisualElement name="Dimmer" class="dimmer">
        <ui:VisualElement name="Panel" class="panel lan">
            <ui:Label text="Local network" class="title"><Bindings><l:LocalizedString property="text" table="UI" entry="lan.title" /></Bindings></ui:Label>
            <ui:VisualElement class="ornament lan__ornament" />

            <!-- You: your name (as the other player sees it; the rule under it while it is typed) and the deck you play -->
            <ui:VisualElement name="You" class="lan__you">
                <ui:VisualElement class="opponent__portrait lan__you-portrait" picking-mode="Ignore">
                    <ui:VisualElement name="YouArt" class="opponent__art" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="lan__you-name">
                    <ui:VisualElement name="NameRow" class="lan__name-row">
                        <ui:TextField name="Name" max-length="16" class="lan__field lan__name" />
                        <ui:VisualElement name="NameEdit" class="lan__name-edit" />
                        <ui:Label name="NameCount" class="lan__name-count" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="NameHint" class="lan__hint" />
                </ui:VisualElement>
                <ui:VisualElement class="lan__you-deck">
                    <ui:Label name="DeckName" class="lan__deck-name" />
                    <ui:Label name="YouDeck" class="lan__detail" />
                </ui:VisualElement>
                <Gwent.UI.DialogButton name="Button Deck" text="Change deck" class="button--secondary lan__small-button"><Bindings><l:LocalizedString property="text" table="UI" entry="lan.change_deck" /></Bindings></Gwent.UI.DialogButton>
            </ui:VisualElement>

            <ui:Label name="Problem" class="lan__problem" />

            <!-- A battle still on when the game closed -->
            <ui:VisualElement name="Rejoin" class="lan__card lan__rejoin">
                <ui:VisualElement class="opponent__portrait" picking-mode="Ignore">
                    <ui:VisualElement name="RejoinArt" class="opponent__art" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="lan__card-text">
                    <ui:Label name="RejoinTitle" class="lan__card-title" />
                    <ui:Label name="RejoinDetail" class="lan__detail" />
                </ui:VisualElement>
                <Gwent.UI.DialogButton name="Button Abandon" text="Abandon" class="button--secondary lan__small-button"><Bindings><l:LocalizedString property="text" table="UI" entry="lan.abandon" /></Bindings></Gwent.UI.DialogButton>
            </ui:VisualElement>

            <!-- The battles hosted on the network -->
            <ui:VisualElement name="Browse" class="lan__browse">
                <ui:VisualElement class="lan__section-head">
                    <ui:Label text="Battles on your network" class="lan__heading"><Bindings><l:LocalizedString property="text" table="UI" entry="lan.battles" /></Bindings></ui:Label>
                    <ui:VisualElement name="Live" class="lan__live" picking-mode="Ignore" />
                    <ui:Label name="LiveText" text="Searching" class="lan__live-text" />
                </ui:VisualElement>
                <ui:ScrollView name="Games" class="lan__games scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement name="Empty" class="lan__empty">
                    <ui:Label name="EmptyText" class="lan__empty-body" />
                </ui:VisualElement>
                <ui:VisualElement name="AddressRow" class="lan__address">
                    <ui:TextField name="Address" max-length="64" class="lan__field lan__address-field" />
                    <Gwent.UI.DialogButton name="Button Join" text="Join" class="button--secondary lan__small-button"><Bindings><l:LocalizedString property="text" table="UI" entry="lan.join" /></Bindings></Gwent.UI.DialogButton>
                </ui:VisualElement>
                <Gwent.UI.DialogButton name="Button Address" text="Join by address" class="button--ghost lan__link"><Bindings><l:LocalizedString property="text" table="UI" entry="lan.join_address" /></Bindings></Gwent.UI.DialogButton>
            </ui:VisualElement>

            <!-- A battle hosted or joined: both players face to face -->
            <ui:VisualElement name="Room" class="lan__room">
                <ui:Label name="RoomTitle" class="lan__heading" />
                <ui:VisualElement class="lan__versus">
                    <ui:VisualElement name="SeatMe" class="lan__seat" />
                    <ui:Label text="vs" class="lan__vs" />
                    <ui:VisualElement name="SeatThem" class="lan__seat" />
                </ui:VisualElement>
                <ui:Label name="RoomStatus" class="lan__status" />
                <ui:VisualElement name="Reach" class="lan__reach">
                    <ui:Label name="ReachText" class="lan__detail" />
                    <Gwent.UI.DialogButton name="Button Copy" text="Copy" class="button--ghost lan__copy" />
                    <Gwent.UI.DialogButton name="Button Details" text="Details" class="button--ghost lan__copy" />
                </ui:VisualElement>
                <!-- On asking: each network this device can be joined on (a VPN's too) and its address there, and the ports -->
                <ui:VisualElement name="Details" class="lan__details">
                    <ui:VisualElement name="Networks" />
                    <ui:Label name="Ports" class="lan__details-note" />
                    <ui:Label text="Friends on your VPN (Tailscale, ZeroTier, Hamachi...) can join from anywhere with its address." class="lan__details-note"><Bindings><l:LocalizedString property="text" table="UI" entry="lan.vpn_note" /></Bindings></ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="lan__buttons">
                <Gwent.UI.DialogButton name="Button Main" text="Host a battle" class="button--primary lan__button" />
                <Gwent.UI.DialogButton name="Button Back" text="Stop hosting" class="button--secondary lan__button" />
            </ui:VisualElement>
            <!-- This build (both players need the same one) -->
            <ui:Label name="Build" class="lan__build" picking-mode="Ignore" />
            <Gwent.UI.DialogButton name="Button Close" text="×" class="button--close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

  m_SharedData: {fileID: 11400000, guid: c4ae92e5dae156342ab8e00e812fd1cf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 19206813229056
    m_Localized: "\u0411\u0438\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337920
    m_Localized: "\u0413\u0432\u0438\u043D\u0442 \u2014 \u043A\u0430\u0440\u0442\u043E\u0447\u043D\u0430\u044F \u0438\u0433\u0440\u0430 \u0434\u043B\u044F \u0434\u0432\u043E\u0438\u0445. \u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0434\u0432\u0430 \u0440\u0430\u0443\u043D\u0434\u0430 \u0438\u0437 \u0442\u0440\u0435\u0445: \u0440\u0430\u0443\u043D\u0434 \u0434\u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435, \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0441\u0443\u043C\u043C\u0430 \u043A\u0430\u0440\u0442 \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337921
    m_Localized: "\u0424\u0440\u0430\u043A\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337922
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u043A\u043E\u043B\u043E\u0434\u0430 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043F\u044F\u0442\u0438 \u0444\u0440\u0430\u043A\u0446\u0438\u0439, \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0441\u0432\u043E\u0438\u043C\u0438 \u043A\u0430\u0440\u0442\u0430\u043C\u0438; \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u043A \u043B\u044E\u0431\u043E\u0439 \u043A\u043E\u043B\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337923
    m_Localized: "\u041A\u0430\u0440\u0442\u044B \u0432 \u0440\u0443\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337924
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0435\u0442\u0435 10 \u043A\u0430\u0440\u0442 \u0438 \u043F\u0435\u0440\u0435\u0434 \u043F\u0435\u0440\u0432\u044B\u043C \u0440\u0430\u0443\u043D\u0434\u043E\u043C \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0434\u043E 2 \u0438\u0437 \u043D\u0438\u0445. \u041C\u0435\u0436\u0434\u0443 \u0440\u0430\u0443\u043D\u0434\u0430\u043C\u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u0435\u0440\u0435\u0442 \u043A\u0430\u0440\u0442, \u0442\u0430\u043A \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u0430\u044F \u0441\u044B\u0433\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u2014 \u044D\u0442\u043E \u043D\u0430 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443 \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0440\u0430\u0443\u043D\u0434\u044B; \u0431\u043E\u043B\u044C\u0448\u0435 \u043A\u0430\u0440\u0442 \u0434\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0448\u043F\u0438\u043E\u043D\u044B, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043B\u0438\u0434\u0435\u0440\u044B \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432 \u0421\u0435\u0432\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337925
    m_Localized: "\u0412\u0430\u0448 \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337926
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0447\u0442\u043E-\u0442\u043E \u043E\u0434\u043D\u043E: \u0441\u044B\u0433\u0440\u0430\u0439\u0442\u0435 \u043A\u0430\u0440\u0442\u0443, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043B\u0438\u0434\u0435\u0440\u0430 \u0438\u043B\u0438 \u0441\u043F\u0430\u0441\u0443\u0439\u0442\u0435. \u0421\u044B\u0433\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337927
    m_Localized: "\u0411\u043E\u0435\u0432\u044B\u0435 \u0440\u044F\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337928
    m_Localized: "\u041E\u0442\u0440\u044F\u0434\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439, \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0439 \u0438\u043B\u0438 \u043E\u0441\u0430\u0434\u043D\u044B\u0439 \u0440\u044F\u0434, \u043A\u0430\u043A \u0443\u043A\u0430\u0437\u0430\u043D\u043E \u043D\u0430 \u043A\u0430\u0440\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337929
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337930
    m_Localized: "\u041F\u043E\u0433\u043E\u0434\u0430, \xAB\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u0440\u043E\u0433\xBB, \xAB\u0427\u0443\u0447\u0435\u043B\u043E\xBB \u0438 \xAB\u041A\u0430\u0437\u043D\u044C\xBB, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0432\u0430\u0448\u0435\u0433\u043E \u043B\u0438\u0434\u0435\u0440\u0430 \u043C\u043E\u0433\u0443\u0442 \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0438\u0442\u044C \u0445\u043E\u0434 \u0440\u0430\u0443\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337931
    m_Localized: "\u041F\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337932
    m_Localized: "\u041F\u0430\u0441 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u0435\u043D \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0440\u0430\u0443\u043D\u0434\u0430: \u0432\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u0432 \u043D\u0435\u043C \u043D\u0435 \u0438\u0433\u0440\u0430\u0435\u0442\u0435, \u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C. \u041A\u043E\u0433\u0434\u0430 \u0441\u043F\u0430\u0441\u0443\u044E\u0442 \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0440\u0430\u0443\u043D\u0434 \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u0442, \u0443 \u043A\u043E\u0433\u043E \u0441\u0443\u043C\u043C\u0430 \u0431\u043E\u043B\u044C\u0448\u0435. \u0421\u0442\u043E\u0440\u043E\u043D\u0430, \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435\u0442 \u043D\u0438 \u043A\u0430\u0440\u0442, \u043D\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043B\u0438\u0434\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C, \u043F\u0430\u0441\u0443\u0435\u0442 \u0441\u0430\u043C\u0430, \u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0430, \u043D\u0430\u0447\u0430\u0432\u0448\u0430\u044F \u0440\u0430\u0443\u043D\u0434 \u0431\u0435\u0437 \u043A\u0430\u0440\u0442, \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337933
    m_Localized: "\u0416\u0438\u0437\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337934
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0434\u0432\u0430 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430, \u0438 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043D\u043D\u044B\u0439 \u0440\u0430\u0443\u043D\u0434 \u043E\u043D\u0430 \u0442\u0435\u0440\u044F\u0435\u0442 \u043E\u0434\u0438\u043D; \u043D\u0438\u0447\u044C\u044F \u0441\u0442\u043E\u0438\u0442 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430 \u043E\u0431\u0435\u0438\u043C \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C (\u0435\u0441\u043B\u0438 \u043D\u0435 \u0438\u0433\u0440\u0430\u0435\u0442 \u041D\u0438\u043B\u044C\u0444\u0433\u0430\u0430\u0440\u0434). \u041F\u043E\u0442\u0435\u0440\u044F\u0432 \u043E\u0431\u0430, \u0432\u044B \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442\u0435 \u0431\u0438\u0442\u0432\u0443. \u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C \u0440\u0430\u0443\u043D\u0434\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439, \u0430 \u043F\u043E\u043B\u0435 \u043C\u0435\u0436\u0434\u0443 \u0440\u0430\u0443\u043D\u0434\u0430\u043C\u0438 \u043E\u0447\u0438\u0449\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337935
    m_Localized: "\u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337936
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0442\u044C \u0440\u0430\u0443\u043D\u0434 \u0441 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C \u043E\u0442\u0440\u044B\u0432\u043E\u043C \u2014 \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043B\u0438\u0448\u043D\u0438\u0435 \u043A\u0430\u0440\u0442\u044B. \u0427\u0430\u0441\u0442\u043E \u043B\u0443\u0447\u0448\u0435 \u0443\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0440\u0430\u0443\u043D\u0434 \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u0443\u044E \u0440\u0443\u043A\u0443 \u043D\u0430 \u0434\u0432\u0430 \u0434\u0440\u0443\u0433\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337937
    m_Localized: "\u041F\u043E\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337938
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0442\u0440\u0438 \u0440\u044F\u0434\u0430; \u0432\u0430\u0448\u0438 \u2014 \u0432 \u043D\u0438\u0436\u043D\u0435\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 \u0441\u0442\u043E\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337939
    m_Localized: "\u0420\u044F\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337940
    m_Localized: "\u0420\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439, \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0439 \u0438 \u043E\u0441\u0430\u0434\u043D\u044B\u0439 \u2014 \u043E\u0442 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B \u0441\u0442\u043E\u043B\u0430 \u043A \u043A\u0440\u0430\u044E. \u041E\u0442\u0440\u044F\u0434 \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u0440\u044F\u0434, \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u0435\u0433\u043E \u043A\u0430\u0440\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337941
    m_Localized: "\u0421\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337942
    m_Localized: "\u0421\u0438\u043B\u0430 \u043E\u0442\u0440\u044F\u0434\u0430 \u2014 \u0447\u0438\u0441\u043B\u043E \u0432 \u0443\u0433\u043B\u0443 \u0435\u0433\u043E \u043A\u0430\u0440\u0442\u044B. \u0421\u0443\u043C\u043C\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0440\u044F\u0434\u0430 \u2014 \u0441\u043B\u0435\u0432\u0430 \u043E\u0442 \u043D\u0435\u0433\u043E, \u0441\u0443\u043C\u043C\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u2014 \u0443 \u0435\u0435 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0430; \u0443 \u0432\u0435\u0434\u0443\u0449\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043E\u043D\u0430 \u0432 \u043B\u0430\u0432\u0440\u043E\u0432\u043E\u043C \u0432\u0435\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337943
    m_Localized: "\u041C\u0430\u043D\u0435\u0432\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337944
    m_Localized: "\u041C\u0430\u043D\u0435\u0432\u0440\u0435\u043D\u043D\u044B\u0439 \u043E\u0442\u0440\u044F\u0434 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C \u0432 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0439 \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337945
    m_Localized: "\u041C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0440\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337946
    m_Localized: "\u041C\u0435\u0441\u0442\u043E \u0441\u043B\u0435\u0432\u0430 \u043E\u0442 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0440\u044F\u0434\u0430 \u0432\u043C\u0435\u0449\u0430\u0435\u0442 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443: \xAB\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u0440\u043E\u0433\xBB \u0438\u043B\u0438 \xAB\u041C\u0430\u0440\u0434\u0440\u0435\u043C\xBB \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337947
    m_Localized: "\u041F\u043E\u043B\u0435 \u043F\u043E\u0433\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337948
    m_Localized: "\u041A\u0430\u0440\u0442\u044B \u043F\u043E\u0433\u043E\u0434\u044B \u0438 \xAB\u041A\u0430\u0437\u043D\u044C\xBB \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u043B\u0435 \u043F\u043E\u0433\u043E\u0434\u044B, \u0441\u043B\u0435\u0432\u0430 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435. \u041F\u043E\u0433\u043E\u0434\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430 \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337949
    m_Localized: "\u0427\u0435\u0439 \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337950
    m_Localized: "\u041F\u0430\u043D\u0435\u043B\u044C \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0445\u043E\u0434\u0438\u0442, \u043E\u0431\u0432\u0435\u0434\u0435\u043D\u0430 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u043C\u0438\u0441\u044F \u0437\u043E\u043B\u043E\u0442\u044B\u043C\u0438 \u043B\u0438\u043D\u0438\u044F\u043C\u0438; \u0441\u043F\u0430\u0441\u043E\u0432\u0430\u0432\u0448\u0430\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u0430 \u0437\u0430\u0442\u0435\u043C\u043D\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337951
    m_Localized: "\u0421\u0431\u0440\u043E\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337952
    m_Localized: "\u041A\u0430\u0440\u0442\u044B, \u043F\u043E\u043A\u0438\u043D\u0443\u0432\u0448\u0438\u0435 \u043F\u043E\u043B\u0435, \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0441\u0431\u0440\u043E\u0441 \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430, \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u043E\u043B\u043E\u0434\u043E\u0439. \u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u0441\u0431\u0440\u043E\u0441\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337953
    m_Localized: "\u041A\u0430\u0440\u0442\u044B, \u043F\u043E\u043A\u0438\u043D\u0443\u0432\u0448\u0438\u0435 \u043F\u043E\u043B\u0435, \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0441\u0431\u0440\u043E\u0441 \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430, \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u043E\u043B\u043E\u0434\u043E\u0439. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0441\u0431\u0440\u043E\u0441, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337954
    m_Localized: "\u041A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337955
    m_Localized: "\u0412 \u043A\u043E\u043B\u043E\u0434\u0435 \u043E\u0434\u0438\u043D \u043B\u0438\u0434\u0435\u0440, \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 22 \u043A\u0430\u0440\u0442 \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0438 \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 10 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043A\u0430\u0440\u0442, \u0438 \u043A\u0430\u0436\u0434\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0432 \u043D\u0435\u0439 \u043D\u0435 \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043E\u043D\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337956
    m_Localized: "\u0413\u0435\u0440\u043E\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337957
    m_Localized: "\u041E\u0442\u0440\u044F\u0434\u044B \u0432 \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u0440\u0430\u043C\u043A\u0435. \u041D\u0430 \u043D\u0438\u0445 \u043D\u0438\u0447\u0442\u043E \u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442: \u043D\u0438 \u043F\u043E\u0433\u043E\u0434\u0430, \u043D\u0438 \u0440\u043E\u0433, \u043D\u0438 \u043F\u0440\u0438\u043B\u0438\u0432 \u0441\u0438\u043B, \u043D\u0438 \xAB\u041A\u0430\u0437\u043D\u044C\xBB, \u043D\u0438 \xAB\u0427\u0443\u0447\u0435\u043B\u043E\xBB, \u043D\u0438 \u043C\u0435\u0434\u0438\u043A. \u0413\u0435\u0440\u043E\u0439 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0432 \u043A\u043E\u043B\u043E\u0434\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337958
    m_Localized: "\u041E\u0442\u0440\u044F\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337959
    m_Localized: "\u0412\u0441\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0432 \u0440\u044F\u0434\u0430\u0445. \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u043E\u0434\u043D\u043E\u043C \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0435; \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0411\u043E\u0435\u0446 \u0421\u0438\u043D\u0438\u0445 \u041F\u043E\u043B\u043E\u0441\u043E\u043A, \u2014 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337960
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337961
    m_Localized: "\u041F\u043E\u0433\u043E\u0434\u0430, \xAB\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439 \u0440\u043E\u0433\xBB, \xAB\u0427\u0443\u0447\u0435\u043B\u043E\xBB \u0438 \xAB\u041A\u0430\u0437\u043D\u044C\xBB: \u043E\u043D\u0438 \u043C\u0435\u043D\u044F\u044E\u0442 \u043F\u043E\u043B\u0435, \u0430 \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337962
    m_Localized: "\u041B\u0438\u0434\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337963
    m_Localized: "\u041E\u0434\u043D\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u0437 \u0437\u0430 \u0431\u0438\u0442\u0432\u0443: \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443 \u043B\u0438\u0434\u0435\u0440\u0430, \u0438 \u0435\u0433\u043E \u043A\u043E\u0440\u043E\u043D\u0430 \u0437\u0430\u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F; \u043A\u043E\u0440\u043E\u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C. \u041F\u043E\u0441\u043B\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u043A\u043E\u0440\u043E\u043D\u0430 \u0441\u0435\u0440\u0435\u0435\u0442. \u0423 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043B\u0438\u0434\u0435\u0440\u043E\u0432 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337964
    m_Localized: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337965
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u044B \u0437\u043D\u0430\u0447\u043A\u0430\u043C\u0438 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u043E\u0442\u0440\u044F\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337966
    m_Localized: "\u0428\u043F\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337967
    m_Localized: "\u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 (\u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F\u0441\u044C \u043A \u0435\u0433\u043E \u0441\u0443\u043C\u043C\u0435), \u0430 \u0432\u044B \u0431\u0435\u0440\u0435\u0442\u0435 2 \u043A\u0430\u0440\u0442\u044B \u0438\u0437 \u0441\u0432\u043E\u0435\u0439 \u043A\u043E\u043B\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337968
    m_Localized: "\u041C\u0435\u0434\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337969
    m_Localized: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043E\u0442\u0440\u044F\u0434 \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E \u0441\u0431\u0440\u043E\u0441\u0430 \u0438 \u0441\u0440\u0430\u0437\u0443 \u0435\u0433\u043E \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u0435\u0442 (\u043D\u0435 \u0433\u0435\u0440\u043E\u0435\u0432 \u0438 \u043D\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B). \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u0439 \u043C\u0435\u0434\u0438\u043A \u043B\u0435\u0447\u0438\u0442 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337970
    m_Localized: "\u0414\u0432\u043E\u0439\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337971
    m_Localized: "\u0421\u0440\u0430\u0437\u0443 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u044B \u0442\u043E\u0433\u043E \u0436\u0435 \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0430 \u0438\u0437 \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043B\u043E\u0434\u044B \u0438 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337972
    m_Localized: "\u041F\u0440\u043E\u0447\u043D\u0430\u044F \u0441\u0432\u044F\u0437\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337973
    m_Localized: "\u041A\u043E\u043F\u0438\u0438 \u044D\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u044B \u0432 \u043E\u0434\u043D\u043E\u043C \u0440\u044F\u0434\u0443 \u0443\u043C\u043D\u043E\u0436\u0430\u044E\u0442 \u0441\u0438\u043B\u0443 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430: \u0434\u0432\u0435 \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u044E\u0442 \u0435\u0435, \u0442\u0440\u0438 \u0443\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442."
    m_Metadata:

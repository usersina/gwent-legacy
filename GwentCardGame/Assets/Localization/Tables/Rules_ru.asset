      m_Items: []
  - m_Id: 19206884532232
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043D\u0435\u0435 \u0432 \u0440\u0443\u043A\u0435, \u0437\u0430\u0442\u0435\u043C \u043D\u0430 \u043C\u0435\u0441\u0442\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F (\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0437\u043D\u0430\u043A \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u043A\u0443\u0434\u0430 \u043D\u0435\u043B\u044C\u0437\u044F). \u041A\u043B\u0430\u0432\u0438\u0448\u0438: \u0412\u043B\u0435\u0432\u043E \u0438 \u0412\u043F\u0440\u0430\u0432\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442 \u043A\u0430\u0440\u0442\u0443, Enter \u0431\u0435\u0440\u0435\u0442 \u0435\u0435, \u0412\u0432\u0435\u0440\u0445 \u0438 \u0412\u043D\u0438\u0437 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442 \u043C\u0435\u0441\u0442\u043E, Enter \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u0435\u0442 \u0435\u0435, Esc \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532233
    m_Localized: "\u041B\u0438\u0434\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532234
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043B\u0438\u0434\u0435\u0440\u0430, \u0437\u0430\u0442\u0435\u043C \u043D\u0430 \u0435\u0433\u043E \u0441\u0432\u0435\u0442\u044F\u0449\u0443\u044E\u0441\u044F \u043A\u043E\u0440\u043E\u043D\u0443; \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0435 \u043C\u0435\u0441\u0442\u043E (\u0438\u043B\u0438 Esc), \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0435\u0433\u043E. \u041A\u043B\u0430\u0432\u0438\u0448\u0438: X, \u0437\u0430\u0442\u0435\u043C X \u0438\u043B\u0438 Enter."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532235
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u043A\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532236
    m_Localized: "\u041F\u0440\u0438 \u0437\u0430\u043C\u0435\u043D\u0435 \u043A\u0430\u0440\u0442 \u0438 \u043A\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443: \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043A\u0430\u0440\u0442\u0443, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u0435\u0435, \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u0435\u0449\u0435 \u0440\u0430\u0437 (\u0438\u043B\u0438 Enter), \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C. \u041F\u0440\u043E\u0431\u0435\u043B \u0438\u043B\u0438 \xAB\u0413\u043E\u0442\u043E\u0432\u043E\xBB \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u0443\u044E \u0440\u0443\u043A\u0443; \xD7 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0432\u044B\u0431\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532237
    m_Localized: "\u041F\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532238
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u041F\u0440\u043E\u0431\u0435\u043B \u0438\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435, \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u043E\u0432\u0430\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532239
    m_Localized: "\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532240
    m_Localized: "\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C \u043D\u0430 \u043A\u0430\u0440\u0442\u0443, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0435 \u043A\u0440\u0443\u043F\u043D\u043E; \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0441\u0431\u0440\u043E\u0441, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532241
    m_Localized: "\u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532242
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043F\u043E\u043B\u043E\u0441\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u044B (\u043F\u043E\u0440\u0442\u0440\u0435\u0442, \u0438\u043C\u044F, \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B \u0438\u043B\u0438 \u0441\u0447\u0435\u0442): \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0435\u0435 \u0444\u0440\u0430\u043A\u0446\u0438\u0438, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0435\u0435 \u043B\u0438\u0434\u0435\u0440\u0430 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0430 \u043B\u0438 \u043E\u043D\u0430, \u0435\u0435 \u043A\u0430\u0440\u0442\u044B \u0432 \u0440\u0443\u043A\u0435, \u0432 \u043A\u043E\u043B\u043E\u0434\u0435 \u0438 \u0432 \u0441\u0431\u0440\u043E\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532243
    m_Localized: "\u0427\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532244
    m_Localized: "\u0412 \u0431\u0438\u0442\u0432\u0435 \u043F\u043E \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u0438: E (\u0438\u043B\u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0435 \u043D\u0430 \u0441\u0432\u043E\u0439 \u043F\u043E\u0440\u0442\u0440\u0435\u0442) \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u044B\u0435 \u0444\u0440\u0430\u0437\u044B, \u0430 1\u20138 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442 \u043E\u0434\u043D\u0443 \u0438\u0437 \u043D\u0438\u0445. T (\u0438\u043B\u0438 \u0437\u043D\u0430\u0447\u043E\u043A \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0430) \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0447\u0430\u0442: \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E, \u043F\u043E\u043B\u0435 \u0434\u043B\u044F \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F, \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0437\u0432\u0443\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532245
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532246
    m_Localized: "Esc \u0432\u0435\u0437\u0434\u0435 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E: \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u043A\u043D\u043E, \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F, \u0432\u044B\u0431\u043E\u0440 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F (\u0441 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C); \u0437\u0430\u0442\u0435\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043C\u0435\u043D\u044E \u043F\u0430\u0443\u0437\u044B. \u0412 \u0433\u043B\u0430\u0432\u043D\u043E\u043C \u043C\u0435\u043D\u044E \u043E\u043D\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442, \u0432\u044B\u0439\u0442\u0438 \u043B\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B (\u043D\u0435 \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435)."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532247
    m_Localized: "\u041F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532248
    m_Localized: "Esc \u0438\u043B\u0438 \u043A\u043D\u043E\u043F\u043A\u0430 \u043C\u0435\u043D\u044E: \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C, \u043F\u0440\u0430\u0432\u0438\u043B\u0430, \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438, \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0431\u0438\u0442\u0432\u0443. \u041A\u043D\u043E\u043F\u043A\u0430 ? \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u044D\u0442\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532249
    m_Localized: "\u0421\u0434\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532250
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0441\u0432\u043E\u044E \u043A\u043E\u043B\u043E\u0434\u0443, \u043A\u043E\u0433\u0434\u0430 \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430\u0434 \u043D\u0435\u0439 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u0441\u044F \u0432 \u0440\u0443\u043A\u0443, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435. \u042D\u0442\u043E \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []

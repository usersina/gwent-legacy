  - m_Id: 19206880337979
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u043E\u0442\u0440\u044F\u0434 (\u043E\u0442\u0440\u044F\u0434\u044B) \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u0432 \u044D\u0442\u043E\u043C \u0440\u044F\u0434\u0443, \u0435\u0441\u043B\u0438 \u0441\u0443\u043C\u043C\u0430 \u0440\u044F\u0434\u0430 10 \u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435. \xAB\u041A\u0430\u0437\u043D\u044C\xBB \u041F\u0438\u0440\u0430\u0442\u0430 \u043A\u043B\u0430\u043D\u0430 \u0414\u0438\u043C\u0443\u043D \u2014 \u043A\u0430\u043A \u0443 \u043A\u0430\u0440\u0442\u044B \xAB\u041A\u0430\u0437\u043D\u044C\xBB: \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u043E\u0442\u0440\u044F\u0434 (\u043E\u0442\u0440\u044F\u0434\u044B) \u043D\u0430 \u0432\u0441\u0435\u043C \u043F\u043E\u043B\u0435 \u0432 \u043C\u043E\u043C\u0435\u043D\u0442 \u0435\u0433\u043E \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F (\u043D\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u043D \u0441\u0430\u043C)."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337980
    m_Localized: "\u041C\u0430\u043D\u0435\u0432\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337981
    m_Localized: "\u0420\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0439 \u0440\u044F\u0434, \u043D\u0430 \u0432\u0430\u0448 \u0432\u044B\u0431\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337982
    m_Localized: "\u0411\u0435\u0440\u0441\u0435\u0440\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337983
    m_Localized: "\u0411\u0435\u0440\u0441\u0435\u0440\u043A\u0438 \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439 \u0432 \u0440\u044F\u0434\u0443 \u0441 \xAB\u041C\u0430\u0440\u0434\u0440\u0435\u043C\u043E\u043C\xBB (\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u043E\u0439 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0434\u043B\u044F \u0440\u043E\u0433\u0430 \u0438\u043B\u0438 \u041C\u044B\u0448\u043E\u0432\u0443\u0440\u043E\u043C \u0432 \u0440\u044F\u0434\u0443), \u043D\u0435\u0432\u0430\u0436\u043D\u043E, \u043A\u0442\u043E \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u043C: \u0411\u0435\u0440\u0441\u0435\u0440\u043A (4) \u2014 \u0432 \u0412\u0438\u043B\u044C\u0434\u043A\u0430\u0440\u043B\u0430 (14, \u043F\u0440\u0438\u043B\u0438\u0432 \u0441\u0438\u043B), \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0431\u0435\u0440\u0441\u0435\u0440\u043A (2) \u2014 \u0432 \u041C\u043E\u043B\u043E\u0434\u043E\u0433\u043E \u0432\u0438\u043B\u044C\u0434\u043A\u0430\u0440\u043B\u0430 (8, \u043F\u0440\u043E\u0447\u043D\u0430\u044F \u0441\u0432\u044F\u0437\u044C). \u041F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F\u0441\u044C, \u0411\u0435\u0440\u0441\u0435\u0440\u043A \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0432\u0430\u0448 \u0441\u0431\u0440\u043E\u0441: \u043C\u0435\u0434\u0438\u043A \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0435\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u0441\u043D\u043E\u0432\u0430. \u041C\u0435\u0434\u0432\u0435\u0434\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043F\u043E\u043B\u0435 \u0438 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442, \u043F\u043E\u043A\u0438\u043D\u0443\u0432 \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337984
    m_Localized: "\u041C\u0441\u0442\u0438\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337985
    m_Localized: "\u041A\u043E\u0440\u043E\u0432\u0430 \u0438 \u041A\u0430\u043C\u0431\u0438 \u0441\u043E \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435: \u0435\u0441\u043B\u0438 \u0438\u0445 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \xAB\u041A\u0430\u0437\u043D\u044C\xBB, \u0437\u0430 \u043D\u0438\u0445 \u0441\u0440\u0430\u0437\u0443 \u043C\u0441\u0442\u044F\u0442 \u2014 \u0432 \u0432\u0430\u0448 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u0440\u044F\u0434 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0427\u0451\u0440\u0442 (8) \u0438\u043B\u0438 \u0425\u0435\u0439\u043C\u0434\u0430\u043B\u043B\u044C (11, \u0433\u0435\u0440\u043E\u0439). \u0421\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u043B\u044E\u0431\u044B\u043C \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C (\u043F\u0440\u0438 \u043E\u0447\u0438\u0441\u0442\u043A\u0435 \u043F\u043E\u043B\u044F \u0432 \u043A\u043E\u043D\u0446\u0435 \u0440\u0430\u0443\u043D\u0434\u0430 \u0438\u043B\u0438 \u0438\u0437 \u0440\u0443\u043A\u0438 \u042D\u0440\u0435\u0434\u0438\u043D\u043E\u043C: \u0413\u0443\u0431\u0438\u0442\u0435\u043B\u0435\u043C \u043C\u0438\u0440\u043E\u0432) \u043C\u0441\u0442\u0438\u0442\u0435\u043B\u044C \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0432 \u0432\u0430\u0448 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u0440\u044F\u0434 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0440\u0430\u0443\u043D\u0434\u0430; \u0435\u0441\u043B\u0438 \u0431\u0438\u0442\u0432\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F \u0440\u0430\u043D\u044C\u0448\u0435, \u043E\u043D \u043D\u0435 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F. \xAB\u0427\u0443\u0447\u0435\u043B\u043E\xBB, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0435\u0435 \u0438\u0445 \u0432 \u0440\u0443\u043A\u0443, \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0435\u0442. \u041C\u0441\u0442\u0438\u0442\u0435\u043B\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043F\u043E\u043B\u0435: \u043D\u0438 \xAB\u0427\u0443\u0447\u0435\u043B\u043E\xBB, \u043D\u0438 \u043C\u0435\u0434\u0438\u043A \u0438\u0445 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442, \u0438 \u043E\u043D\u0438 \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442, \u043F\u043E\u043A\u0438\u043D\u0443\u0432 \u043F\u043E\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337986
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880337987
    m_Localized: "\u041F\u043E\u0433\u043E\u0434\u0430 \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0434\u043E 1 \u0441\u0438\u043B\u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043E\u0442\u0440\u044F\u0434\u0430, \u043A\u0440\u043E\u043C\u0435 \u0433\u0435\u0440\u043E\u0435\u0432, \u0432 \u0441\u0432\u043E\u0438\u0445 \u0440\u044F\u0434\u0430\u0445, \u0443 \u043E\u0431\u0435\u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D."
    m_Metadata:

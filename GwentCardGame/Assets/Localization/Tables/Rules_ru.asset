  - m_Id: 19206880337975
    m_Localized: "\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 1 \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u043E\u0442\u0440\u044F\u0434\u0443 \u0432 \u0441\u0432\u043E\u0435\u043C \u0440\u044F\u0434\u0443."

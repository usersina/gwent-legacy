  - m_Id: 19206880338000
    m_Localized: "\u0427\u0443\u0447\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338001
    m_Localized: "\u0417\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u0432\u0430\u0448\u0438\u0445 \u043E\u0442\u0440\u044F\u0434\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432 \u0440\u0443\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u0441\u044B\u0433\u0440\u0430\u043B\u0438 \u0441\u043D\u043E\u0432\u0430 (\u043D\u0435 \u0433\u0435\u0440\u043E\u044F \u0438 \u043D\u0435 \u043F\u0440\u0438\u0437\u0432\u0430\u043D\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0443, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0427\u0451\u0440\u0442\u0430)."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338002
    m_Localized: "\u041A\u0430\u0437\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338003
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u043E\u0442\u0440\u044F\u0434 (\u043E\u0442\u0440\u044F\u0434\u044B) \u043D\u0430 \u0432\u0441\u0435\u043C \u043F\u043E\u043B\u0435, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0432\u0430\u0448\u0438 (\u043A\u0440\u043E\u043C\u0435 \u0433\u0435\u0440\u043E\u0435\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338004
    m_Localized: "\u041C\u0430\u0440\u0434\u0440\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338005
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435: \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0434\u043B\u044F \u0440\u043E\u0433\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0411\u0435\u0440\u0441\u0435\u0440\u043A\u043E\u0432 \u044D\u0442\u043E\u0433\u043E \u0440\u044F\u0434\u0430 \u0432 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338006
    m_Localized: "\u0424\u0440\u0430\u043A\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338007
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u0444\u0440\u0430\u043A\u0446\u0438\u0438 \u0441\u0432\u043E\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E, \u0438 \u0441\u0432\u043E\u0438 \u043B\u0438\u0434\u0435\u0440\u044B \u043D\u0430 \u0432\u044B\u0431\u043E\u0440 (\u0434\u0432\u0430 \u043B\u0438\u0434\u0435\u0440\u0430 \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0432 \xAB\u041A\u0440\u043E\u0432\u0438 \u0438 \u0432\u0438\u043D\u0435\xBB). \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043F\u0430\u043B\u0435\u0446 \u043D\u0430 \u043B\u0438\u0434\u0435\u0440\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0435\u0433\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338008
    m_Localized: "\u0423 \u043A\u0430\u0436\u0434\u043E\u0439 \u0444\u0440\u0430\u043A\u0446\u0438\u0438 \u0441\u0432\u043E\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E, \u0438 \u0441\u0432\u043E\u0438 \u043B\u0438\u0434\u0435\u0440\u044B \u043D\u0430 \u0432\u044B\u0431\u043E\u0440 (\u0434\u0432\u0430 \u043B\u0438\u0434\u0435\u0440\u0430 \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0432 \xAB\u041A\u0440\u043E\u0432\u0438 \u0438 \u0432\u0438\u043D\u0435\xBB). \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C \u043D\u0430 \u043B\u0438\u0434\u0435\u0440\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0435\u0433\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338009
    m_Localized: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338010
    m_Localized: "\u0412\u0441\u0435 \u0434\u0435\u043B\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u0441\u0430\u043D\u0438\u044F\u043C\u0438; \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043F\u0430\u043B\u0435\u0446 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338011
    m_Localized: "\u0412\u0441\u0435 \u0434\u0435\u043B\u0430\u0435\u0442\u0441\u044F \u043C\u044B\u0448\u044C\u044E, \u0438 \u0442\u0430\u043A \u0436\u0435 \u2014 \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338012
    m_Localized: "\u0421\u044B\u0433\u0440\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338013
    m_Localized: "\u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u0435\u0435 \u0432 \u0440\u0443\u043A\u0435 (\u043E\u043D\u0430 \u043F\u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043A\u0440\u0443\u043F\u043D\u043E \u0441\u043F\u0440\u0430\u0432\u0430), \u0437\u0430\u0442\u0435\u043C \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043C\u0435\u0441\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338014
    m_Localized: "\u041B\u0438\u0434\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338015
    m_Localized: "\u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043B\u0438\u0434\u0435\u0440\u0430, \u0437\u0430\u0442\u0435\u043C \u0435\u0433\u043E \u0441\u0432\u0435\u0442\u044F\u0449\u0435\u0439\u0441\u044F \u043A\u043E\u0440\u043E\u043D\u044B; \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043F\u0443\u0441\u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0435\u0433\u043E. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043F\u0430\u043B\u0435\u0446 \u043D\u0430 \u043A\u043E\u0440\u043E\u043D\u0435, \u0447\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C, \u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u0435\u0449\u0435 \u0435\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338016
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u043A\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338017
    m_Localized: "\u041F\u0440\u0438 \u0437\u0430\u043C\u0435\u043D\u0435 \u043A\u0430\u0440\u0442 \u0438 \u043A\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443: \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043A\u0430\u0440\u0442\u044B, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u0435\u0435, \u0438 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u0435\u0449\u0435 \u0440\u0430\u0437, \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C. \xAB\u0413\u043E\u0442\u043E\u0432\u043E\xBB \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u0443\u044E \u0440\u0443\u043A\u0443; \xD7 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0432\u044B\u0431\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338018
    m_Localized: "\u041F\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338019
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435, \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u043E\u0432\u0430\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338020
    m_Localized: "\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338021
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043F\u0430\u043B\u0435\u0446 \u043D\u0430 \u043B\u044E\u0431\u043E\u0439 \u043A\u0430\u0440\u0442\u0435 (\u043D\u0430 \u043F\u043E\u043B\u0435, \u0432 \u0440\u0443\u043A\u0435, \u043D\u0430 \u043B\u0438\u0434\u0435\u0440\u0435), \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0435 \u043A\u0440\u0443\u043F\u043D\u043E; \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u0441\u0431\u0440\u043E\u0441\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338022
    m_Localized: "\u041C\u0430\u0441\u0448\u0442\u0430\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338023
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0438\u0442\u0435 \u0434\u0432\u0430 \u043F\u0430\u043B\u044C\u0446\u0430 \u043D\u0430 \u043F\u043E\u043B\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C \u0435\u0433\u043E. \u041F\u0440\u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438 \u043E\u0434\u043D\u0438\u043C \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E\u043B\u0435 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F, \u0430 \u0437\u0430\u043C\u043E\u043A \u043F\u043E\u0434 \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u0435\u043D\u044E \u0435\u0433\u043E \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442: \u043A\u0430\u0441\u0430\u043D\u0438\u044F \u0442\u043E\u0433\u0434\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u044E\u0442, \u0438 \u043C\u043E\u0436\u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F. \u0414\u0432\u043E\u0439\u043D\u043E\u0435 \u043A\u0430\u0441\u0430\u043D\u0438\u0435 \u0441\u0442\u043E\u043B\u0430 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442 \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0438\u043B\u0438 \u043E\u0442\u0434\u0430\u043B\u044F\u0435\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E; \u043B\u0443\u043F\u0430 \u0442\u043E\u0436\u0435 \u043E\u0442\u0434\u0430\u043B\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338024
    m_Localized: "\u0421\u0442\u043E\u0440\u043E\u043D\u0430 \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338025
    m_Localized: "\u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043F\u043E\u043B\u043E\u0441\u044B \u0441\u0442\u043E\u0440\u043E\u043D\u044B (\u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0430, \u0438\u043C\u0435\u043D\u0438, \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432 \u0438\u043B\u0438 \u0441\u0447\u0435\u0442\u0430): \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0435\u0435 \u0444\u0440\u0430\u043A\u0446\u0438\u0438, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0435\u0435 \u043B\u0438\u0434\u0435\u0440\u0430 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0430 \u043B\u0438 \u043E\u043D\u0430, \u0435\u0435 \u043A\u0430\u0440\u0442\u044B \u0432 \u0440\u0443\u043A\u0435, \u0432 \u043A\u043E\u043B\u043E\u0434\u0435 \u0438 \u0432 \u0441\u0431\u0440\u043E\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 19206880338026
    m_Localized: "\u0427\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532224
    m_Localized: "\u0412 \u0431\u0438\u0442\u0432\u0435 \u043F\u043E \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u0438: \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u0441\u0432\u043E\u0435\u0433\u043E \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u0430 \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u044B\u0445 \u0444\u0440\u0430\u0437, \u0435\u0433\u043E \u0437\u043D\u0430\u0447\u043A\u0430 \u2014 \u0434\u043B\u044F \u0447\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532225
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532226
    m_Localized: "\u041A\u043D\u043E\u043F\u043A\u0430 \xAB\u041D\u0430\u0437\u0430\u0434\xBB Android \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E: \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u043A\u043D\u043E, \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F, \u0432\u044B\u0431\u043E\u0440 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F (\u0441 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C), \u043F\u043E\u043B\u0435 \u043E\u0442\u0434\u0430\u043B\u044F\u0435\u0442\u0441\u044F; \u0437\u0430\u0442\u0435\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043C\u0435\u043D\u044E \u043F\u0430\u0443\u0437\u044B. \u0412 \u0433\u043B\u0430\u0432\u043D\u043E\u043C \u043C\u0435\u043D\u044E \u043E\u043D\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442, \u0432\u044B\u0439\u0442\u0438 \u043B\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532227
    m_Localized: "\u041F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532228
    m_Localized: "\u041A\u043D\u043E\u043F\u043A\u0430 \u043C\u0435\u043D\u044E: \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C, \u043F\u0440\u0430\u0432\u0438\u043B\u0430, \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438, \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0431\u0438\u0442\u0432\u0443. \u041A\u043D\u043E\u043F\u043A\u0430 ? \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u044D\u0442\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532229
    m_Localized: "\u0421\u0434\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 19206884532230
    m_Localized: "\u0412 \u0441\u0432\u043E\u0439 \u0445\u043E\u0434 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043F\u0430\u043B\u0435\u0446 \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u043A\u043E\u043B\u043E\u0434\u0435, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435. \u042D\u0442\u043E \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:

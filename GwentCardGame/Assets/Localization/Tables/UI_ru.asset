  - m_Id: 6579991060486
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060487
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060488
    m_Localized: "\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u0438\u0433\u0440\u0430\u0435\u0442 \u043A\u0430\u043A \u043D\u043E\u0432\u0438\u0447\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060489
    m_Localized: "\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u0431\u0435\u0440\u0435\u0436\u0435\u0442 \u043A\u0430\u0440\u0442\u044B \u043D\u0430 \u043F\u043E\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060490
    m_Localized: "\u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u043F\u0440\u043E\u0434\u0443\u043C\u044B\u0432\u0430\u0435\u0442 \u0432\u0441\u044E \u0431\u0438\u0442\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060491
    m_Localized: "\u0426\u0435\u043D\u0437\u0443\u0440\u043D\u044B\u0435 \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060492
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438\u043B\u043B\u044E\u0441\u0442\u0440\u0430\u0446\u0438\u0439 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043A\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060493
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060494
    m_Localized: "\u041F\u0440\u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0435, \u0441\u043E \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B \u0438\u0433\u0440\u044B \u043D\u0430 GitHub"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060495
    m_Localized: "\u041E\u0431\u0449\u0430\u044F \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060496
    m_Localized: "\u041C\u0443\u0437\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060497
    m_Localized: "\u0417\u0432\u0443\u043A\u043E\u0432\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060498
    m_Localized: "\u0413\u043B\u0443\u0448\u0438\u0442\u044C \u0432 \u0444\u043E\u043D\u043E\u0432\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060499
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0435 \u043E\u043A\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060500
    m_Localized: "\u041F\u043E\u043B\u043D\u043E\u044D\u043A\u0440\u0430\u043D\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060501
    m_Localized: "\u0412\u044B\u0445\u043E\u0434 \u043F\u043E \u043A\u043B\u0430\u0432\u0438\u0448\u0435 Esc"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060502
    m_Localized: "\u041E\u043A\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060503
    m_Localized: "\u0412 \u043E\u043A\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060504
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060505
    m_Localized: "\u0427\u0430\u0441\u0442\u043E\u0442\u0430 \u043A\u0430\u0434\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060506
    m_Localized: "\u0411\u0435\u0437 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060507
    m_Localized: "\u041D\u0438\u0437\u043A\u0438\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u044F\u0442 \u0431\u0430\u0442\u0430\u0440\u0435\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060508
    m_Localized: "\u0412\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u0441 \u044D\u043A\u0440\u0430\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060509
    m_Localized: "\u0420\u0430\u0437\u043C\u0435\u0440 \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060510
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043C\u0435\u043D\u044E \u0438 \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060511
    m_Localized: "\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060512
    m_Localized: "\u0417\u0430\u0434\u0430\u0435\u0442 \u0432\u0441\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u043D\u0438\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060513
    m_Localized: "\u041D\u0438\u0437\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060514
    m_Localized: "\u0421\u0440\u0435\u0434\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060515
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060516
    m_Localized: "\u041E\u0441\u043E\u0431\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060517
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u0447\u0430\u0441\u0442\u0438\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060518
    m_Localized: "\u041C\u0435\u043D\u044C\u0448\u0435 \u0438\u0441\u043A\u0440, \u043F\u043B\u0430\u043C\u0435\u043D\u0438 \u0438 \u043A\u0430\u043F\u0435\u043B\u044C \u0434\u043E\u0436\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060519
    m_Localized: "\u041F\u043E\u0433\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060520
    m_Localized: "\u042D\u0444\u0444\u0435\u043A\u0442\u044B \u0431\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060521
    m_Localized: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060522
    m_Localized: "\u041C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060523
    m_Localized: "\u0410\u043D\u0438\u043C\u0430\u0446\u0438\u044F \u043F\u043E\u0433\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060524
    m_Localized: "\u041E\u0442\u043A\u043B.: \u0441\u0442\u0430\u0442\u0438\u0447\u043D\u044B\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060525
    m_Localized: "\u041C\u043E\u043B\u043D\u0438\u044F \u0438 \u0433\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060526
    m_Localized: "\u0412 \xAB\u0428\u0442\u043E\u0440\u043C\u0435 \u0441\u043E \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060527
    m_Localized: "\u0421\u043E\u043B\u043D\u0446\u0435 \xAB\u042F\u0441\u043D\u043E\u0433\u043E \u043D\u0435\u0431\u0430\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060528
    m_Localized: "\u041B\u0443\u0447\u0438, \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u044E\u0449\u0438\u0435 \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060529
    m_Localized: "\u041F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0433\u0435\u0440\u043E\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060530
    m_Localized: "\u041E\u0442\u043A\u043B.: \u043A\u0440\u0430\u0439 \u043A\u0430\u0440\u0442\u044B \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442 \u0437\u043E\u043B\u043E\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060531
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \xAB\u041A\u0430\u0437\u043D\u0438\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060532
    m_Localized: "\u041E\u0442\u043A\u043B.: \u043A\u0430\u0440\u0442\u044B \u043E\u0431\u0443\u0433\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0431\u0435\u0437 \u043E\u0433\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060533
    m_Localized: "\u0412\u0441\u043F\u044B\u0448\u043A\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439"
    m_Metadata:

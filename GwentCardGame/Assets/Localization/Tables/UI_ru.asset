    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435, \u043A\u0443\u0434\u0430 \u0432\u044B\u043B\u043E\u0436\u0438\u0442\u044C {0}"

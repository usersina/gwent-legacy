    m_Localized: "\u0413\u0432\u0438\u043D\u0442 \u0413\u0435\u0440\u0430\u043B\u044C\u0442\u0430 \u043F\u043E \u0437\u0435\u043C\u043B\u044F\u043C \xAB\u0412\u0435\u0434\u044C\u043C\u0430\u043A\u0430 3\xBB: \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0439\u0442\u0435 \u0438\u0433\u0440\u043E\u043A\u043E\u0432, \u043F\u043E\u043A\u0443\u043F\u0430\u0439\u0442\u0435 \u043A\u0430\u0440\u0442\u044B \u0443 \u043A\u043E\u0440\u0447\u043C\u0430\u0440\u0435\u0439, \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0438 \u0441\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043E\u043B\u043D\u0443\u044E \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E."

    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0430\u0434\u0440\u0435\u0441, \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044F \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []

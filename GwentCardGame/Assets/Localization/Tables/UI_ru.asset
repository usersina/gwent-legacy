      m_Items: []
  - m_Id: 801611777
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 801611778
    m_Localized: "\u0424\u0430\u043D\u0430\u0442\u0441\u043A\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442, \u043D\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0439 \u0441 CD PROJEKT RED"

    m_Metadata:
      m_Items: []
  - m_Id: 15369981370445
    m_Localized: "\u0421\u0432\u044F\u0437\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430: \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F {0}{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370446
    m_Localized: "\u0421\u0432\u044F\u0437\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430: \u043F\u0435\u0440\u0435\u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A {0}{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370447
    m_Localized: "{0} \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u0436\u0434\u0430\u0442\u044C \u0438\u043B\u0438 \u0437\u0430\u044F\u0432\u0438\u0442\u0435 \u043F\u043E\u0431\u0435\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370448
    m_Localized: "{0} \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u0436\u0434\u0430\u0442\u044C \u0438\u043B\u0438 \u0441\u0434\u0430\u0439\u0442\u0435\u0441\u044C (\u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435)."
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370449
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443 \u043F\u043E\u0433\u043E\u0434\u044B \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u044B \u0434\u043B\u044F \u0440\u043E\u0437\u044B\u0433\u0440\u044B\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370450
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0442\u0440\u044F\u0434 \u0438\u0437 \u0441\u0431\u0440\u043E\u0441\u0430, \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0435\u0433\u043E \u043D\u0430 \u043F\u043E\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370451
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0442\u0440\u044F\u0434 \u0438\u0437 \u0441\u0431\u0440\u043E\u0441\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370452
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0442\u0440\u044F\u0434 \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E \u0441\u0431\u0440\u043E\u0441\u0430, \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370453
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443 \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370454
    m_Localized: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B \u0438\u0437 \u0440\u0443\u043A\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370455
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370456
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0432\u044B\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370457
    m_Localized: "\u041D\u0435 \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u043F\u043E\u0433\u043E\u0434\u044B? \u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043B\u0438\u0434\u0435\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u0430, \u0430 \u0445\u043E\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370458
    m_Localized: "\u041D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C \u043E\u0442\u0440\u044F\u0434? \u041C\u0435\u0434\u0438\u043A \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F, \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C, \u0430 \u0445\u043E\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370459
    m_Localized: "\u041D\u0435 \u0431\u0440\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443? \u0414\u0432\u0435 \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u044B \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B, \u0430 \u0445\u043E\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370460
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0431\u0440\u0430\u0442\u044C \u0438\u0437 \u0441\u0431\u0440\u043E\u0441\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430? \u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043B\u0438\u0434\u0435\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u0430, \u0430 \u0445\u043E\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 15369981370461
    m_Localized: "\u041D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443? \u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u043B\u0438\u0434\u0435\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u0430, \u0430 \u0445\u043E\u0434 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []

  - m_Id: 6579991060636
    m_Localized: "\u041F\u043E\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060637
    m_Localized: "\u041D\u0435\u0442 \u0441\u0435\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060638
    m_Localized: "\u0412\u044B \u043D\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u044B \u043A \u0441\u0435\u0442\u0438. \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u0441\u044C \u043A Wi-Fi \u0438\u043B\u0438 \u0442\u043E\u0447\u043A\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430 \u0434\u043B\u044F \u0438\u0433\u0440\u044B \u043F\u043E \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0435\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060639
    m_Localized: "\u0418\u0433\u0440 \u043F\u043E\u043A\u0430 \u043D\u0435\u0442. \u0418\u0433\u0440\u043E\u043A\u0438 \u0432 \u0432\u0430\u0448\u0435\u0439 \u0441\u0435\u0442\u0438 Wi-Fi \u0438\u043B\u0438 \u0442\u043E\u0447\u043A\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060640
    m_Localized: "\u0414\u0440\u0443\u0433\u0430\u044F \u0441\u0431\u043E\u0440\u043A\u0430 \u0438\u0433\u0440\u044B ({0}): \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060641
    m_Localized: "\u0412 \u044D\u0442\u043E\u0439 \u0431\u0438\u0442\u0432\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0434\u0440\u0443\u0433\u0430\u044F \u0441\u0431\u043E\u0440\u043A\u0430 \u0438\u0433\u0440\u044B ({0}; \u0443 \u0432\u0430\u0441: {1}). \u0423 \u043E\u0431\u043E\u0438\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0430\u044F \u0441\u0431\u043E\u0440\u043A\u0430."
    m_Metadata:
      m_Items: []

    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536130
    m_Localized: "\u0418\u0433\u0440\u044B \u0432 \u0432\u0430\u0448\u0435\u0439 \u0441\u0435\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536131
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536132
    m_Localized: "\u041F\u043E IP-\u0430\u0434\u0440\u0435\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536133
    m_Localized: "\u0414\u0440\u0443\u0437\u044C\u044F \u0432 \u0432\u0430\u0448\u0435\u0439 VPN (Tailscale, ZeroTier, Hamachi...) \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F \u043E\u0442\u043E\u0432\u0441\u044E\u0434\u0443 \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u0430\u0434\u0440\u0435\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536134
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536135
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0431\u0438\u0442\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536136
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3598415536137
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []

      m_Items: []
  - m_Id: 6579991060640
    m_Localized: "Otra compilaci\xF3n del juego ({0}): no se puede entrar"
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060641
    m_Localized: "Esa batalla usa otra compilaci\xF3n del juego ({0}; la tuya: {1}). Ambos jugadores necesitan la misma compilaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 6579991060642

      m_Items: []
  - m_Id: 17695546777829
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0439 \u043E\u0442\u0440\u044F\u0434 (\u043E\u0442\u0440\u044F\u0434\u044B) \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0435\u0441\u043B\u0438 \u043E\u0431\u0449\u0430\u044F \u0441\u0438\u043B\u0430 \u0435\u0433\u043E \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u0440\u044F\u0434\u0430 10 \u0438\u043B\u0438 \u0432\u044B\u0448\u0435."

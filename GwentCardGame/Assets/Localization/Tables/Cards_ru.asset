  - m_Id: 17695546777809
    m_Localized: "\u041F\u0440\u043E\u0447\u043D\u0430\u044F \u0441\u0432\u044F\u0437\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777810
    m_Localized: "\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u0430\u0440\u0442\u043E\u0439 \u0441 \u0442\u0435\u043C \u0436\u0435 \u0438\u043C\u0435\u043D\u0435\u043C, \u0447\u0442\u043E\u0431\u044B \u0443\u0434\u0432\u043E\u0438\u0442\u044C \u0441\u0438\u043B\u0443 \u043E\u0431\u0435\u0438\u0445 \u043A\u0430\u0440\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777811
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u043E\u0442\u0440\u044F\u0434 (\u043E\u0442\u0440\u044F\u0434\u044B) \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u0435\u0441\u043B\u0438 \u043E\u0431\u0449\u0430\u044F \u0441\u0438\u043B\u0430 \u0435\u0433\u043E \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u043E\u0433\u043E \u0440\u044F\u0434\u0430 10 \u0438\u043B\u0438 \u0432\u044B\u0448\u0435."
    m_Metadata:

      m_Items: []
  - m_Id: 17695546777819
    m_Localized: "\u041C\u0435\u0434\u0438\u043A\u0438 \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043B\u0438\u0434\u0435\u0440\u043E\u0432, \u0432\u043E\u0441\u043A\u0440\u0435\u0448\u0430\u044E\u0449\u0438\u0435 \u043E\u0442\u0440\u044F\u0434, \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 (\u043C\u0435\u0434\u0438\u043A-\u0433\u0435\u0440\u043E\u0439 \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0430\u043C). \u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430 \u043E\u0431\u043E\u0438\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []

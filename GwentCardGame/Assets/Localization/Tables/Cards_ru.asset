  - m_Id: 17695546777786
    m_Localized: "\u041C\u0430\u043D\u0435\u0432\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777787
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0432\u044B\u043B\u043E\u0436\u0435\u043D \u043A\u0430\u043A \u0432 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u0440\u044F\u0434, \u0442\u0430\u043A \u0438 \u0432 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777788
    m_Localized: "\u041C\u0441\u0442\u0438\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777789
    m_Localized: "\u0415\u0441\u043B\u0438 \u043A\u0430\u0440\u0442\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0430 \xAB\u041A\u0430\u0437\u043D\u044C\u044E\xBB, \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0435\u0442 \u0425\u0435\u0439\u043C\u0434\u0430\u043B\u043B\u044F \u0432 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u0440\u044F\u0434. \u0415\u0441\u043B\u0438 \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u0430 \u043B\u044E\u0431\u044B\u043C \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C, \u043E\u043D \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0440\u0430\u0443\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777790
    m_Localized: "\u0415\u0441\u043B\u0438 \u043A\u0430\u0440\u0442\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0430 \xAB\u041A\u0430\u0437\u043D\u044C\u044E\xBB, \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0435\u0442 \u0427\u0451\u0440\u0442\u0430 \u0432 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0439 \u0440\u044F\u0434. \u0415\u0441\u043B\u0438 \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u0430 \u043B\u044E\u0431\u044B\u043C \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C, \u043E\u043D \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0440\u0430\u0443\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777791
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442 \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0432\u0441\u0435\u0445 \u0431\u0435\u0440\u0441\u0435\u0440\u043A\u043E\u0432 \u0432 \u0442\u043E\u043C \u0436\u0435 \u0440\u044F\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777792
    m_Localized: "\u0423\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443 \u0432\u0441\u0435\u0445 \u043A\u0430\u0440\u0442 \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0432 \u0441\u0432\u043E\u0435\u043C \u0440\u044F\u0434\u0443. \u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 1 \u043A\u0430\u0440\u0442\u0430 \u043D\u0430 \u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777793
    m_Localized: "\u0423\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0442\u0440\u044F\u0434\u043E\u0432 \u0432 \u0441\u0432\u043E\u0435\u043C \u0440\u044F\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777794
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443 \u0432\u0441\u0435\u0445 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0445 \u043A\u0430\u0440\u0442 \u0440\u0430\u0432\u043D\u043E\u0439 1 \u0434\u043B\u044F \u043E\u0431\u043E\u0438\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777795
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443 \u0432\u0441\u0435\u0445 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0445 \u043A\u0430\u0440\u0442 \u0440\u0430\u0432\u043D\u043E\u0439 1 \u0434\u043B\u044F \u043E\u0431\u043E\u0438\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777796
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443 \u0432\u0441\u0435\u0445 \u043E\u0441\u0430\u0434\u043D\u044B\u0445 \u043A\u0430\u0440\u0442 \u0440\u0430\u0432\u043D\u043E\u0439 1 \u0434\u043B\u044F \u043E\u0431\u043E\u0438\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777797
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443 \u0432\u0441\u0435\u0445 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u044B\u0445 \u0438 \u043E\u0441\u0430\u0434\u043D\u044B\u0445 \u043A\u0430\u0440\u0442 \u0440\u0430\u0432\u043D\u043E\u0439 1 \u0434\u043B\u044F \u043E\u0431\u043E\u0438\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777798
    m_Localized: "\u0421\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0441\u0435 \u043F\u043E\u0433\u043E\u0434\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B (\xAB\u041B\u044E\u0442\u044B\u0439 \u043C\u043E\u0440\u043E\u0437\xBB, \xAB\u0413\u0443\u0441\u0442\u043E\u0439 \u0442\u0443\u043C\u0430\u043D\xBB, \xAB\u041C\u0433\u043B\u0438\u0441\u0442\u044B\u0439 \u0434\u043E\u0436\u0434\u044C\xBB \u0438 \xAB\u0428\u0442\u043E\u0440\u043C \u0441\u043E \u0421\u043A\u0435\u043B\u043B\u0438\u0433\u0435\xBB)."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777799
    m_Localized: "\u0417\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u043A\u0430\u0440\u0442\u0443 \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u043E\u044F, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044F \u0435\u0435 \u0432 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777800
    m_Localized: "\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0439\u0448\u0443\u044E \u043A\u0430\u0440\u0442\u0443 (\u0438\u043B\u0438 \u043A\u0430\u0440\u0442\u044B) \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u043E\u044F \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u0441\u0431\u0440\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777801
    m_Localized: "\u0428\u043F\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777802
    m_Localized: "\u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u043B\u0435 \u0431\u043E\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 (\u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0432 \u0435\u0433\u043E \u043F\u043E\u043B\u044C\u0437\u0443) \u0438 \u0431\u0435\u0440\u0435\u0442 2 \u043A\u0430\u0440\u0442\u044B \u0438\u0437 \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043B\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777803
    m_Localized: "\u041C\u0435\u0434\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777804
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443 \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u0431\u0440\u043E\u0441\u0430 \u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0441\u044B\u0433\u0440\u0430\u0439\u0442\u0435 \u0435\u0435 (\u043A\u0440\u043E\u043C\u0435 \u0433\u0435\u0440\u043E\u0435\u0432 \u0438 \u0441\u043F\u0435\u0446\u043A\u0430\u0440\u0442)."
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777805
    m_Localized: "\u0414\u0432\u043E\u0439\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 17695546777806
    m_Localized: "\u041D\u0430\u0445\u043E\u0434\u0438\u0442 \u0432 \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043B\u043E\u0434\u0435 \u0438 \u0440\u0443\u043A\u0435 \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u044B \u0441 \u0442\u0435\u043C \u0436\u0435 \u0438\u043C\u0435\u043D\u0435\u043C \u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0438\u0445 \u043D\u0430 \u043F\u043E\u043B\u0435."
